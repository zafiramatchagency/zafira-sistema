      "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Payment Received | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Your Zafira evaluation payment has been received. Next steps of your process.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"css/styles.css\">\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'en';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\"><img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA</a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <a href=\"https://zafiramatchagency.com/caballeros/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\n  <section class=\"sec\">\n    <div class=\"wrap-sm text-center\">\n      <!-- Success icon -->\n      <div class=\"fade\" style=\"width:72px;height:72px;border:2px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 28px\">\n        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n      </div>\n      <h1 class=\"heading-section fade d1\" data-es=\"Gracias. Recibimos el pago de la evaluación y verificación. La verificación empieza hoy.\" data-en=\"Thank you. We have received the evaluation and verification payment. Verification begins today.\">Thank you. We have received the evaluation and verification payment. Verification begins today.</h1>\n      <div class=\"fade d3\" style=\"margin:28px auto\">\n        <span class=\"pill pill-gold\" id=\"planPill\">—</span>\n      </div>\n\n      <!-- Lo que sigue -->\n      <div class=\"info-block fade d4\" style=\"text-align:left;margin-top:36px\">\n        <h2 style=\"font-family:var(--ff-d);font-size:1.1rem;margin-bottom:16px\" data-es=\"Lo que sigue\" data-en=\"What happens next\">What happens next</h2>\n        <ol style=\"list-style:none\">\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">1.</span><span class=\"text-body\" data-es-html=\"<strong style='color:var(--gold)'>Revise su correo.</strong> Le llega un enlace seguro para completar su formulario de registro. El enlace vale 72 horas. Si no lo ve en 15 minutos, revise la carpeta de spam.\" data-en-html=\"<strong style='color:var(--gold)'>Check your email.</strong> You will receive a secure link to complete your registration form. The link is valid for 72 hours. If you do not see it within 15 minutes, check your spam folder.\"><strong style='color:var(--gold)'>Check your email.</strong> You will receive a secure link to complete your registration form. The link is valid for 72 hours. If you do not see it within 15 minutes, check your spam folder.</span></li>\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">2.</span><span class=\"text-body\" data-es-html=\"<strong style='color:var(--gold)'>Complete el formulario con información precisa.</strong> Se usa para la verificación de antecedentes y para la búsqueda de candidatas compatibles.\" data-en-html=\"<strong style='color:var(--gold)'>Complete the form accurately.</strong> It is used for the background verification and for the search for compatible candidates.\"><strong style='color:var(--gold)'>Complete the form accurately.</strong> It is used for the background verification and for the search for compatible candidates.</span></li>\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">3.</span><span class=\"text-body\" data-es-html=\"<strong style='color:var(--gold)'>Su asesor lo contacta en 48 horas hábiles</strong> para agendar la consulta inicial.\" data-en-html=\"<strong style='color:var(--gold)'>Your assigned advisor will contact you within 48 business hours</strong> to schedule the initial consultation.\"><strong style='color:var(--gold)'>Your assigned advisor will contact you within 48 business hours</strong> to schedule the initial consultation.</span></li>\n        </ol>\n      </div>\n\n      <!-- Su camino -->\n      <div class=\"info-block fade d5\" style=\"text-align:left;margin-top:28px\">\n        <h3 style=\"font-family:var(--ff-d);font-size:1.05rem;margin-bottom:16px\" data-es=\"Su camino\" data-en=\"Your path\">Your path</h3>\n        <ol style=\"list-style:none\">\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">1.</span><span class=\"text-body\" data-es=\"Evaluación y verificación: en curso.\" data-en=\"Evaluation and verification: in progress.\">Evaluation and verification: in progress.</span></li>\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">2.</span><span class=\"text-body\" data-es=\"Aprobación: Zafira decide si usted entra al programa.\" data-en=\"Approval: Zafira decides whether you enter the programme.\">Approval: Zafira decides whether you enter the programme.</span></li>\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">3.</span><span class=\"text-body\" data-es=\"Programa: USD 13.000 en un único pago, solo si lo aprobamos y usted decide continuar, con contrato antes de cualquier cargo.\" data-en=\"Programme: USD 13,000 in a single payment, only if you are approved and decide to continue, with a contract before any charge.\">Programme: USD 13,000 in a single payment, only if you are approved and decide to continue, with a contract before any charge.</span></li>\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">4.</span><span class=\"text-body\" data-es=\"Presentaciones: solo cuando hay compatibilidad real y las dos personas aceptan.\" data-en=\"Introductions: only when there is real compatibility and both people agree.\">Introductions: only when there is real compatibility and both people agree.</span></li>\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">5.</span><span class=\"text-body\" data-es=\"Cartagena: Octubre o noviembre de 2026. Fechas exactas, sede y cupos por confirmar; se confirman antes de abrir los cupos.\" data-en=\"Cartagena: October or November 2026. Exact dates, venue and places to be confirmed before places open.\">Cartagena: October or November 2026. Exact dates, venue and places to be confirmed before places open.</span></li>\n        </ol>\n      </div>\n\n      <p class=\"text-body fade d6\" style=\"margin-top:28px;text-align:left\" data-es=\"Recuerde: pagar la evaluación no es lo mismo que ser aprobado. Si no lo aprobamos, se lo decimos y el proceso termina ahí; los USD 400 no se devuelven porque pagan el estudio, que se hace igual.\" data-en=\"Please remember: paying for the evaluation is not the same as being approved. If you are not approved, we tell you and the process ends there; the USD 400 is not returned, because it pays for the review, which is carried out either way.\">Please remember: paying for the evaluation is not the same as being approved. If you are not approved, we tell you and the process ends there; the USD 400 is not returned, because it pays for the review, which is carried out either way.</p>\n      <p class=\"text-legal fade d6\" style=\"margin-top:20px;text-align:left\" data-es=\"Si usted llegó a esta página sin haber hecho un pago, esta página no le aplica: el proceso empieza por la solicitud, que es gratuita.\" data-en=\"If you reached this page without making a payment, it does not apply to you: the process starts with the application, which is free.\">If you reached this page without making a payment, it does not apply to you: the process starts with the application, which is free.</p>\n      <p class=\"text-legal fade d6\" style=\"margin-top:20px;text-align:left\" data-es-html=\"¿Dudas? Escríbale a Melany por WhatsApp al +1 360 227 7352 o a <a href='mailto:business@zafiramatchagency.com' style='color:var(--gold)'>business@zafiramatchagency.com</a>.\" data-en-html=\"Questions? Message Melany on WhatsApp at +1 360 227 7352 or write to <a href='mailto:business@zafiramatchagency.com' style='color:var(--gold)'>business@zafiramatchagency.com</a>.\">Questions? Message Melany on WhatsApp at +1 360 227 7352 or write to <a href=\"mailto:business@zafiramatchagency.com\" style=\"color:var(--gold)\">business@zafiramatchagency.com</a>.</p>\n      <div class=\"fade d6\" style=\