      "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>The Experience | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Zafira is not simply an event. It is access to a different reality. Discover our elite lifestyle and destinations.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"css/styles.css\">\r\n<style>\r\n  /* ── INLINE STYLES FOR ABOUT LUXURY EXPERIENCE ── */\r\n  :root { --about-bg: #0a0a0f; --about-gold: #C9A84C; --about-text: #e2e2e2; }\r\n  body { background-color: var(--about-bg); overflow-x: hidden; }\r\n  \r\n  /* Hero */\r\n  .a-hero { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; padding: 0 24px; }\r\n  .a-hero-bg { position: absolute; inset: 0; z-index: 0; background-image: url('https://images.unsplash.com/photo-1542314831-c6a4d14effd0?q=80&w=2000'); background-size: cover; background-position: center; filter: brightness(0.4) contrast(1.1); transform: scale(1.05); transition: transform 2s ease-out; }\r\n  .a-hero.vis .a-hero-bg { transform: scale(1); }\r\n  .a-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,10,15,0.8) 0%, rgba(10,10,15,0.4) 40%, var(--about-bg) 100%); z-index: 1; }\r\n  .a-hero-content { position: relative; z-index: 2; max-width: 800px; transform: translateY(30px); opacity: 0; transition: all 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.3s; }\r\n  .a-hero.vis .a-hero-content { transform: translateY(0); opacity: 1; }\r\n  .a-hero-title { font-family: var(--ff-d); font-size: clamp(3rem, 7vw, 5.5rem); font-weight: 500; color: var(--about-gold); letter-spacing: 0.05em; line-height: 1.1; margin-bottom: 24px; text-shadow: 0 10px 40px rgba(0,0,0,0.8); }\r\n  .a-hero-subtitle { font-size: clamp(1rem, 2vw, 1.2rem); color: var(--about-text); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 40px; }\r\n  \r\n  /* Destinations */\r\n  .a-dest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: rgba(201,168,76,0.2); border-top: 1px solid rgba(201,168,76,0.1); border-bottom: 1px solid rgba(201,168,76,0.1); }\r\n  .a-dest-card { position: relative; aspect-ratio: 3/4; overflow: hidden; background: var(--black); cursor: pointer; }\r\n  .a-dest-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.5) grayscale(30%); transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s ease; }\r\n  .a-dest-card:hover .a-dest-img { transform: scale(1.08); filter: brightness(0.9) grayscale(0%); }\r\n  .a-dest-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.1) 60%, transparent 100%); display: flex; flex-direction: column; justify-content: flex-end; padding: 40px 30px; transition: padding 0.6s ease; }\r\n  .a-dest-card:hover .a-dest-overlay { padding-bottom: 50px; }\r\n  .a-dest-city { font-family: var(--ff-d); font-size: 2.2rem; color: var(--white); margin-bottom: 8px; transform: translateY(10px); transition: transform 0.6s ease; }\r\n  .a-dest-card:hover .a-dest-city { transform: translateY(0); color: var(--about-gold); }\r\n  .a-dest-desc { font-size: 0.95rem; color: rgba(255,255,255,0.7); opacity: 0; transform: translateY(10px); transition: all 0.6s ease; line-height: 1.6; }\r\n  .a-dest-card:hover .a-dest-desc { opacity: 1; transform: translateY(0); transition-delay: 0.1s; }\r\n\r\n  /* Lifestyle Grid */\r\n  .a-life-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 100px; }\r\n  .a-life-img-wrap { position: relative; overflow: hidden; border-radius: 2px; box-shadow: 0 30px 60px rgba(0,0,0,0.6); aspect-ratio: 4/5; }\r\n  .a-life-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7); transition: transform 1.5s ease, filter 1.5s ease; }\r\n  .a-life-img-wrap:hover .a-life-img { transform: scale(1.05); filter: brightness(1); }\r\n  @media(max-width: 800px) { .a-life-grid { grid-template-columns: 1fr; gap: 40px; } .a-life-grid:nth-child(even) .a-life-content { order: 1; } .a-life-grid:nth-child(even) .a-life-img-wrap { order: 2; } }\r\n  \r\n  /* Philosophy */\r\n  .a-phil { text-align: center; padding: 140px 24px; position: relative; background: radial-gradient(circle at center, rgba(201,168,76,0.05) 0%, transparent 60%); }\r\n  .a-phil::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 1px; height: 80px; background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.5)); }\r\n  .a-phil-statement { font-family: var(--ff-d); font-size: clamp(2.2rem, 5vw, 4rem); color: var(--white); line-height: 1.2; font-style: italic; margin-bottom: 40px; text-shadow: 0 4px 20px rgba(0,0,0,0.5); }\r\n  \r\n  /* Fade overrides for cinematic feel */\r\n  .c-fade { opacity: 0; transform: translateY(40px); transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }\r\n  .c-fade.vis { opacity: 1; transform: translateY(0); }\r\n  .c-fade.d1 { transition-delay: 0.1s; }\r\n  .c-fade.d2 { transition-delay: 0.2s; }\r\n  .c-fade.d3 { transition-delay: 0.3s; }\r\n</style>\r\n<script>\r\n(function(){\r\n  function getLang(){ return localStorage.getItem('zafiraLang')||'en'; }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){ el.textContent=el.getAttribute('data-'+lang); });\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){ el.innerHTML=el.getAttribute('data-'+lang+'-html'); });\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){ btn.classList.toggle('active', btn.getAttribute('data-lang')===lang); });\r\n  }\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n  document.addEventListener('DOMContentLoaded',function(){ applyLang(getLang()); });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\"><img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA</a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n      <a href=\"https://zafiramatchagency.com/about/\" style=\"color:var(--gold);font-weight:600\" aria-current=\"page\" data-en=\"About\" data-es=\"Nosotros\">About</a><a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" style=\"color:var(--gold);font-weight:600\" aria-current=\"page\" data-en=\"About\" data-es=\"Nosotros\">About</a><a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <a href=\"https://zafiramatchagency.com/caballeros/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n  </div>\r\n</header>\r\n\r\n<main>\r\n\r\n  <!-- 1. CINEMATIC HERO -->\r\n  <section class=\"a-hero\" id=\"about-hero\">\r\n    <div class=\"a-hero-bg\"></div>\r\n    <div class=\"a-hero-overlay\"></div>\r\n    <div class=\"a-hero-content\">\r\n      <div class=\"c-fade d1\">\r\n        <span class=\"pill pill-gold\" style=\"margin-bottom:24px;display:inline-flex;background:rgba(10,10,15,0.5);backdrop-filter:blur(10px)\">\r\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\r\n          <span data-en=\"The Zafira Standard\" data-es=\"El Estándar Zafira\">The Zafira Standard</span>\r\n        </span>\r\n      </div>\r\n      <h1 class=\"a-hero-title c-fade d2\" data-en=\"A Different Reality.\" data-es=\"Una Realidad Diferente.\">A Different Reality.</h1>\r\n      <p class=\"a-hero-subtitle c-fade d3\" data-en=\"Zafira is not an event company. It is a private, accompanied matchmaking process.\" data-es=\"Zafira no es una empresa de eventos. Es un proceso privado y acompañado de matchmaking.\">Zafira is not an event company. It is a private, accompanied matchmaking process.</p>\r\n    </div>\r\n  </section>\r\n\r\n<!-- W10 · QUIÉNES SOMOS -->\r\n<section class=\"sec\" style=\"background:var(--dark); padding:90px 24px;\">\r\n  <div class=\"wrap\" style=\"max-width:860px;\">\r\n    <h2 class=\"heading-section c-fade\" style=\"margin-bottom:24px\" data-es=\"Quiénes somos\" data-en=\"Who we are\">Who we are</h2>\r\n    <p class=\"text-body c-fade d1\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:18px;\" data-es=\"Zafira es una agencia privada de intermediación y consultoría matrimonial, solo por invitación. Acompaña a hombres de Estados Unidos y a mujeres en Colombia que buscan una relación seria con intención de matrimonio, con verificación de las dos partes, consentimiento en cada caso y un encuentro privado en Cartagena.\" data-en=\"Zafira is a private, invitation-only introduction agency and matrimonial consultancy. It accompanies men in the United States and women in Colombia who want a serious relationship with marriage in mind, with verification on both sides, consent in every case and a private gathering in Cartagena.\">Zafira is a private, invitation-only introduction agency and matrimonial consultancy. It accompanies men in the United States and women in Colombia who want a serious relationship with marriage in mind, with verification on both sides, consent in every case and a private gathering in Cartagena.</p>\r\n    <p class=\"text-body c-fade d1\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:18px;\" data-es=\"La empresa es Zafira Limited Edition S.A.S., una sociedad colombiana con oficina en Bogotá y operación en Estados Unidos y Colombia.\" data-en=\"The company is Zafira Limited Edition S.A.S., a Colombian company with its office in Bogotá, operating in the United States and Colombia.\">The company is Zafira Limited Edition S.A.S., a Colombian company with its office in Bogotá, operating in the United States and Colombia.</p>\r\n  </div>\r\n</section>\r\n\r\n<!-- W10 · MISIÓN Y VISIÓN -->\r\n<section class=\"sec\" style=\"background:var(--black); padding:90px 24px;\">\r\n  <div class=\"wrap\">\r\n    <div class=\"grid-2\">\r\n      <div class=\"c-fade\" style=\"padding:40px; border-left:1px solid rgba(201,168,76,0.3); background:rgba(10,10,15,0.6);\">\r\n        <h3 style=\"font-family:var(--ff-d);font-size:2rem;color:var(--gold);margin-bottom:16px;\" data-es=\"Misión\" data-en=\"Mission\">Mission</h3>\r\n        <p class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;\" data-es=\"Presentar a personas verificadas que buscan formar un matrimonio, con un proceso privado, honesto sobre sus costos y sus límites, y en el que nadie es presentado sin haberlo aceptado.\" data-en=\"To introduce verified people who want to build a marriage, through a private process that is honest about its costs and its limits, and in which no one is introduced without having agreed to it.\">To introduce verified people who want to build a marriage, through a private process that is honest about its costs and its limits, and in which no one is introduced without having agreed to it.</p>\r\n      </div>\r\n      <div class=\"c-fade\" style=\"padding:40px; border-left:1px solid rgba(201,168,76,0.3); background:rgba(10,10,15,0.6);\">\r\n        <h3 style=\"font-family:var(--ff-d);font-size:2rem;color:var(--gold);margin-bottom:16px;\" data-es=\"Visión\" data-en=\"Vision\">Vision</h3>\r\n        <p class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;\" data-es=\"Ser la agencia a la que se confía una decisión tan personal por la seriedad de su criterio, el cuidado de la privacidad y el respeto por las dos partes.\" data-en=\"To be the agency people trust with such a personal decision because of the seriousness of its judgment, its care for privacy and its respect for both sides.\">To be the agency people trust with such a personal decision because of the seriousness of its judgment, its care for privacy and its respect for both sides.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- W10 · CÓMO TRABAJAMOS -->\r\n<section class=\"sec\" style=\"background:var(--dark); padding:90px 24px;\">\r\n  <div class=\"wrap\" style=\"max-width:860px;\">\r\n    <h2 class=\"heading-section c-fade\" style=\"margin-bottom:24px\" data-es=\"Cómo trabajamos\" data-en=\"How we work\">How we work</h2>\r\n    <ul class=\"c-fade d1\" style=\"list-style:none;margin:0 0 18px 0\">\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"<strong style='color:var(--gold)'>Identidad.</strong> Documento oficial y antecedentes comprobados antes de que nadie sea presentado.\" data-en-html=\"<strong style='color:var(--gold)'>Identity.</strong> Official document and background checked before anyone is introduced.\"><strong style='color:var(--gold)'>Identity.</strong> Official document and background checked before anyone is introduced.</li>\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"<strong style='color:var(--gold)'>Intención.</strong> Una entrevista privada con la matchmaker para entender qué busca cada persona.\" data-en-html=\"<strong style='color:var(--gold)'>Intention.</strong> A private interview with the matchmaker to understand what each person is looking for.\"><strong style='color:var(--gold)'>Intention.</strong> A private interview with the matchmaker to understand what each person is looking for.</li>\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"<strong style='color:var(--gold)'>Consentimiento.</strong> Nadie es presentado sin haberlo aceptado para ese caso concreto, y cualquiera puede decir que no.\" data-en-html=\"<strong style='color:var(--gold)'>Consent.</strong> No one is introduced without agreeing to that specific introduction, and anyone can say no.\"><strong style='color:var(--gold)'>Consent.</strong> No one is introduced without agreeing to that specific introduction, and anyone can say no.</li>\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"<strong style='color:var(--gold)'>Seguimiento.</strong> El proceso no termina en la presentación: la matchmaker sigue el caso y está pendiente de los dos lados.\" data-en-html=\"<strong style='color:var(--gold)'>Follow-up.</strong> The process does not end at the introduction: the matchmaker follows the case and stays attentive to both sides.\"><strong style='color:var(--gold)'>Follow-up.</strong> The process does not end at the introduction: the matchmaker follows the case and stays attentive to both sides.</li>\r\n    </ul>\r\n    <p class=\"text-body c-fade d1\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:18px;\" data-es=\"Las candidatas participan de forma gratuita y voluntaria: Zafira nunca les pide dinero y ninguna recibe dinero por participar. Los caballeros contratan un servicio profesional de búsqueda, selección, verificación, presentación y acompañamiento.\" data-en=\"Candidates take part free of charge and voluntarily: Zafira never asks them for money and none of them receives money for taking part. Gentlemen contract a professional service of search, selection, verification, introduction and guidance.\">Candidates take part free of charge and voluntarily: Zafira never asks them for money and none of them receives money for taking part. Gentlemen contract a professional service of search, selection, verification, introduction and guidance.</p>\r\n  </div>\r\n</section>\r\n\r\n<!-- W10 · LO QUE ZAFIRA NO ES -->\r\n<section class=\"sec\" style=\"background:var(--black); padding:90px 24px;\">\r\n  <div class=\"wrap\" style=\"max-width:860px;\">\r\n    <h2 class=\"heading-section c-fade\" style=\"margin-bottom:24px\" data-es=\"Lo que Zafira no es\" data-en=\"What Zafira is not\">What Zafira is not</h2>\r\n    <ul class=\"c-fade d1\" style=\"list-style:none;margin:0 0 18px 0\">\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"No es una aplicación ni una plataforma de citas en línea.\" data-en-html=\"It is not an app or an online dating platform.\">It is not an app or an online dating platform.</li>\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"No publica perfiles: ningún caballero conoce el perfil de una candidata sin su permiso.\" data-en-html=\"It does not publish profiles: no gentleman sees a candidate's profile without her permission.\">It does not publish profiles: no gentleman sees a candidate's profile without her permission.</li>\r\n      <li class=\"text-body\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:10px\" data-es-html=\"No promete una relación, un matrimonio ni ningún resultado sentimental.\" data-en-html=\"It does not promise a relationship, a marriage or any romantic outcome.\">It does not promise a relationship, a marriage or any romantic outcome.</li>\r\n    </ul>\r\n  </div>\r\n</section>\r\n\r\n<!-- W10 · DÓNDE -->\r\n<section class=\"sec\" style=\"background:var(--dark); padding:90px 24px;\">\r\n  <div class=\"wrap\" style=\"max-width:860px;\">\r\n    <h2 class=\"heading-section c-fade\" style=\"margin-bottom:24px\" data-es=\"Dónde\" data-en=\"Where\">Where</h2>\r\n    <p class=\"text-body c-fade d1\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:18px;\" data-es=\"Zafira trabaja desde su oficina en Bogotá, Colombia. El encuentro privado de 2026 es en Cartagena.\" data-en=\"Zafira works from its office in Bogotá, Colombia. The 2026 private gathering is in Cartagena.\">Zafira works from its office in Bogotá, Colombia. The 2026 private gathering is in Cartagena.</p>\r\n    <p class=\"text-body c-fade d1\" style=\"font-size:1.05rem;line-height:1.9;margin-bottom:18px;\" data-es=\"Octubre o noviembre de 2026. Fechas exactas, sede y cupos por confirmar; se confirman antes de abrir los cupos.\" data-en=\"October or November 2026. Exact dates, venue and places to be confirmed before places open.\">October or November 2026. Exact dates, venue and places to be confirmed before places open.</p>\r\n    <p class=\"text-body c-fade d2\" style=\"font-size:1.05rem;margin-top:24px;\"><a style=\"color:var(--gold)\" data-es=\"Soy caballero: conocer el programa\" data-en=\"For gentlemen: the programme\" href=\"https://zafiramatchagency.com/caballeros/\">For gentlemen: the programme</a> · <a style=\"color:var(--gold)\" data-es=\"Soy candidata: conocer el registro\" data-en=\"For candidates: registration\" href=\"https://zafiramatchagency.com/damas/\">For candidates: registration</a></p>\r\n  </div>\r\n</section>\r\n\r\n</main>\r\n\r\n<footer class=\"footer\"> \r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-href-en=\"https://zafiramatchagency.com/privacidad/\" data-href-es=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Privacy Policy\" data-es=\"Política de Privacidad\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/terminos/\" data-href-en=\"https://zafiramatchagency.com/terminos/\" data-href-es=\"https://zafiramatchagency.com/terminos-es/\" data-en=\"Terms &amp; Conditions\" data-es=\"Términos y Condiciones\">Terms &amp; Conditions</a>\r\n    <a href=\"https://zafiramatchagency.com/cancelaciones/\" data-href-en=\"https://zafiramatchagency.com/cancelaciones/\" data-href-es=\"https://zafiramatchagency.com/cancelaciones-es/\" data-en=\"Cancellations &amp; Refunds\" data-es=\"Cancelaciones y Reembolsos\">Cancellations &amp; Refunds</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <script>(function(){function u(l){document.querySelectorAll('a[data-href-'+l+']').forEach(function(a){a.href=a.getAttribute('data-href-'+l);});}var o=window.zafiraSetLang;window.zafiraSetLang=function(l){if(o)o(l);u(l);};function i(){u(window.zafiraGetLang?window.zafiraGetLang