  "elements": [
   {
    "id": "b3cd01e",
    "elType": "widget",
    "settings": {
     "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>The Experience | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Zafira is not simply an event. It is access to a different reality. Discover our elite lifestyle and destinations.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"css/styles.css\">\r\n<style>\r\n  /* ── INLINE STYLES FOR ABOUT LUXURY EXPERIENCE ── */\r\n  :root { --about-bg: #0a0a0f; --about-gold: #C9A84C; --about-text: #e2e2e2; }\r\n  body { background-color: var(--about-bg); overflow-x: hidden; }\r\n  \r\n  /* Hero */\r\n  .a-hero { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; padding: 0 24px; }\r\n  .a-hero-bg { position: absolute; inset: 0; z-index: 0; background-image: url('https://images.unsplash.com/photo-1542314831-c6a4d14effd0?q=80&w=2000'); background-size: cover; background-position: center; filter: brightness(0.4) contrast(1.1); transform: scale(1.05); transition: transform 2s ease-out; }\r\n  .a-hero.vis .a-hero-bg { transform: scale(1); }\r\n  .a-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,10,15,0.8) 0%, rgba(10,10,15,0.4) 40%, var(--about-bg) 100%); z-index: 1; }\r\n  .a-hero-content { position: relative; z-index: 2; max-width: 800px; transform: translateY(30px); opacity: 0; transition: all 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.3s; }\r\n  .a-hero.vis .a-hero-content { transform: translateY(0); opacity: 1; }\r\n  .a-hero-title { font-family: var(--ff-d); font-size: clamp(3rem, 7vw, 5.5rem); font-weight: 500; color: var(--about-gold); letter-spacing: 0.05em; line-height: 1.1; margin-bottom: 24px; text-shadow: 0 10px 40px rgba(0,0,0,0.8); }\r\n  .a-hero-subtitle { font-size: clamp(1rem, 2vw, 1.2rem); color: var(--about-text); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 40px; }\r\n  \r\n  /* Destinations */\r\n  .a-dest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: rgba(201,168,76,0.2); border-top: 1px solid rgba(201,168,76,0.1); border-bottom: 1px solid rgba(201,168,76,0.1); }\r\n  .a-dest-card { position: relative; aspect-ratio: 3/4; overflow: hidden; background: var(--black); cursor: pointer; }\r\n  .a-dest-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.5) grayscale(30%); transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s ease; }\r\n  .a-dest-card:hover .a-dest-img { transform: scale(1.08); filter: brightness(0.9) grayscale(0%); }\r\n  .a-dest-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.1) 60%, transparent 100%); display: flex; flex-direction: column; justify-content: flex-end; padding: 40px 30px; transition: padding 0.6s ease; }\r\n  .a-dest-card:hover .a-dest-overlay { padding-bottom: 50px; }\r\n  .a-dest-city { font-family: var(--ff-d); font-size: 2.2rem; color: var(--white); margin-bottom: 8px; transform: translateY(10px); transition: transform 0.6s ease; }\r\n  .a-dest-card:hover .a-dest-city { transform: translateY(0); color: var(--about-gold); }\r\n  .a-dest-desc { font-size: 0.95rem; color: rgba(255,255,255,0.7); opacity: 0; transform: translateY(10px); transition: all 0.6s ease; line-height: 1.6; }\r\n  .a-dest-card:hover .a-dest-desc { opacity: 1; transform: translateY(0); transition-delay: 0.1s; }\r\n\r\n  /* Lifestyle Grid */\r\n  .a-life-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 100px; }\r\n  .a-life-img-wrap { position: relative; overflow: hidden; border-radius: 2px; box-shadow: 0 30px 60px rgba(0,0,0,0.6); aspect-ratio: 4/5; }\r\n  .a-life-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7); transition: transform 1.5s ease, filter 1.5s ease; }\r\n  .a-life-img-wrap:hover .a-life-img { transform: scale(1.05); filter: brightness(1); }\r\n  @media(max-width: 800px) { .a-life-grid { grid-template-columns: 1fr; gap: 40px; } .a-life-grid:nth-child(even) .a-life-content { order: 1; } .a-life-grid:nth-child(even) .a-life-img-wrap { order: 2; } }\r\n  \r\n  /* Philosophy */\r\n  .a-phil { text-align: center; padding: 140px 24px; position: relative; background: radial-gradient(circle at center, rgba(201,168,76,0.05) 0%, transparent 60%); }\r\n  .a-phil::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 1px; height: 80px; background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.5)); }\r\n  .a-phil-statement { font-family: var(--ff-d); font-size: clamp(2.2rem, 5vw, 4rem); color: var(--white); line-height: 1.2; font-style: italic; margin-bottom: 40px; text-shadow: 0 4px 20px rgba(0,0,0,0.5); }\r\n  \r\n  /* Fade overrides for cinematic feel */\r\n  .c-fade { opacity: 0; transform: translateY(40px); transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }\r\n  .c-fade.vis { opacity: 1; transform: translateY(0); }\r\n  .c-fade.d1 { transition-delay: 0.1s; }\r\n  .c-fade.d2 { transition-delay: 0.2s; }\r\n  .c-fade.d3 { transition-delay: 0.3s; }\r\n</style>\r\n<script>\r\n(function(){\r\n  function getLang(){ return localStorage.getItem('zafiraLang')||'en'; }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){ el.textContent=el.getAttribute('data-'+lang); });\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){ el.innerHTML=el.getAttribute('data-'+lang+'-html'); });\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){ btn.classList.toggle('active', btn.getAttribute('data-lang')===lang); });\r\n  }\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n  document.addEventListener('DOMContentLoaded',function(){ applyLang(getLang()); });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\"><img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA</a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n      <a href=\"https://zafiramatchagency.com/about/\" style=\"color:var(--gold);font-weight:600\" aria-current=\"page\" data-en=\"About\" data-es=\"Nosotros\">About</a><a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" style=\"color:var(--gold);font-weight:600\" aria-current=\"page\" data-en=\"About\" data-es=\"Nosotros\">About</a><a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <a href=\"https://zafiramatchagency.com/caballeros/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n  </div>\r\n</header>\r\n\r\n<main>\r\n\r\n  <!-- 1. CINEMATIC HERO -->\r\n  <section class=\"a-hero\" id=\"about-hero\">\r\n    <div class=\"a-hero-bg\"></div>\r\n    <div class=\"a-hero-overlay\"></div>\r\n    <div class=\"a-hero-content\">\r\n      <div class=\"c-fade d1\">\r\n        <span class=\"pill pill-gold\" style=\"margin-bottom:24px;display:inline-flex;background:rgba(10,10,15,0.5);backdrop-filter:blur(10px)\">\r\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\r\n          <span data-en=\"The Zafira Standard\" data-es=\"El Estándar Zafira\">The Zafira Standard</span>\r\n        </span>\r\n      </div>\r\n      <h1 class=\"a-hero-title c-fade d2\" data-en=\"A Different Reality.\" data-es=\"Una Realidad Diferente.\">A Different Reality.</h1>\r\n      <p class=\"a-hero-subtitle c-fade d3\" data-en=\"Zafira is not an event company. It is a private, accompanied matchmaking process.\" data-es=\"Zafira no es una empresa de eventos. Es un proceso privado y acompañado de matchmaking.\">Zafira is not an event company. It is a private, accompanied matchmaking process.</p>\r\n    </div>\r\n  </section>\r\n\r\n<!-- 1.5 WHO WE ARE -->\r\n<section class=\"sec\" style=\"background:var(--dark); padding:100px 24px;\">\r\n  <div class=\"wrap text-center\" style=\"max-width:860px;\">\r\n    \r\n    <h2 class=\"heading-section c-fade\" \r\n    data-en-html=\"Who We <span class='text-gold'>Are</span>\" \r\n    data-es-html=\"Quiénes <span class='text-gold'>Somos</span>\">\r\n    Who We <span class=\"text-gold\">Are</span>\r\n    </h2>\r\n\r\n    <p class=\"text-body c-fade d1\" \r\n    style=\"font-size:1.1rem;line-height:1.9;margin-bottom:24px;\"\r\n    data-en=\"Zafira Match Agency is a private, bilingual matchmaking agency based in Bogotá. We work with men who are seeking a serious relationship and with women who take part voluntarily and free of charge. Every introduction happens only after verification and with the consent of both people.\"\r\n    data-es=\"Zafira Match Agency es una agencia privada y bilingüe de matchmaking con sede en Bogotá. Trabajamos con hombres que buscan una relación seria y con mujeres que participan de forma voluntaria y gratuita. Cada presentación ocurre solo después de la verificación y con el consentimiento de ambas partes.\">\r\n    Zafira Match Agency is a private, bilingual matchmaking agency based in Bogotá. We work with men who are seeking a serious relationship and with women who take part voluntarily and free of charge. Every introduction happens only after verification and with the consent of both people.\r\n    </p>\r\n\r\n    <p class=\"text-body c-fade d2\" \r\n    style=\"font-size:1.1rem;line-height:1.9;\"\r\n    data-en=\"We do not guarantee a relationship or a marriage. We answer for the judgment behind each introduction: interview, identity, marital status and background checked for both sides.\"\r\n    data-es=\"No garantizamos una relación ni un matrimonio. Respondemos por el criterio con el que hacemos cada presentación: entrevista, identidad, estado civil y antecedentes comprobados de ambas partes.\">\r\n    We do not guarantee a relationship or a marriage. We answer for the judgment behind each introduction: interview, identity, marital status and background checked for both sides.\r\n    </p>\r\n\r\n  </div>\r\n</section>\r\n\r\n<!-- 1.6 MISSION & VISION -->\r\n<section class=\"sec\" style=\"background:var(--black); padding:100px 24px; position:relative; overflow:hidden;\">\r\n  \r\n  <div style=\"position:absolute;top:50%;left:50%;width:800px;height:800px;background:radial-gradient(circle,rgba(201,168,76,0.04) 0%,transparent 70%);transform:translate(-50%,-50%);z-index:0;pointer-events:none;\"></div>\r\n\r\n  <div class=\"wrap\" style=\"position:relative; z-index:1;\">\r\n    \r\n    <div class=\"grid-2\">\r\n\r\n      <div class=\"c-fade\" style=\"padding:40px; border-left:1px solid rgba(201,168,76,0.3); background:rgba(10,10,15,0.6);\">\r\n        \r\n        <h3 style=\"font-family:var(--ff-d);font-size:2rem;color:var(--gold);margin-bottom:16px;\" \r\n        data-en=\"Our Mission\" \r\n        data-es=\"Nuestra Misión\">\r\n        Our Mission\r\n        </h3>\r\n\r\n        <p class=\"text-body\" \r\n        style=\"font-size:1.05rem;line-height:1.9;\"\r\n        data-en=\"To introduce people who want a serious relationship, with discretion, verification and personal accompaniment at every step.\"\r\n        data-es=\"Presentar a personas que buscan una relación seria, con discreción, verificación y acompañamiento personal en cada paso.\">\r\n        To introduce people who want a serious relationship, with discretion, verification and personal accompaniment at every step.\r\n        </p>\r\n\r\n      </div>\r\n\r\n      <div class=\"c-fade d1\" style=\"padding:40px; border-left:1px solid rgba(201,168,76,0.3); background:rgba(10,10,15,0.6);\">\r\n        \r\n        <h3 style=\"font-family:var(--ff-d);font-size:2rem;color:var(--gold);margin-bottom:16px;\" \r\n        data-en=\"Our Vision\" \r\n        data-es=\"Nuestra Visión\">\r\n        Our Vision\r\n        </h3>\r\n\r\n        <p class=\"text-body\" \r\n        style=\"font-size:1.05rem;line-height:1.9;\"\r\n        data-en=\"To be the most trusted private matchmaking agency between the United States and Latin America, recognised for its judgment and its care for both sides.\"\r\n        data-es=\"Ser la agencia privada de matchmaking más confiable entre Estados Unidos y Latinoamérica, reconocida por su criterio y su cuidado con ambas partes.\">\r\n        To be the most trusted private matchmaking agency between the United States and Latin America, recognised for its judgment and its care for both sides.\r\n        </p>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n  </div>\r\n</section>\r\n\r\n  <!-- 2. DESTINATIONS -->\r\n  <section class=\"sec\" style=\"padding:0; background:var(--black)\">\r\n    <div class=\"a-dest-grid\">\r\n      <!-- Cartagena -->\r\n      <div class=\"a-dest-card c-fade\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/Cartagena.png\" alt=\"Cartagena\" class=\"a-dest-img\">\r\n        <div class=\"a-dest-overlay\">\r\n          <h3 class=\"a-dest-city\">Cartagena</h3>\r\n          <p class=\"a-dest-desc\" data-en=\"Where the in-person programme takes place: October or November 2026, dates to be confirmed.\" data-es=\"Donde se realiza el programa presencial: octubre o noviembre de 2026, fechas por confirmar.\">Where the in-person programme takes place: October or November 2026, dates to be confirmed.</p>\r\n        </div>\r\n      </div>\r\n      <!-- Medellín -->\r\n      <div class=\"a-dest-card c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/Medellin.png\" alt=\"Verification\" class=\"a-dest-img\">\r\n        <div class=\"a-dest-overlay\">\r\n          <h3 class=\"a-dest-city\" data-en=\"Verification\" data-es=\"Verificación\">Verification</h3>\r\n          <p class=\"a-dest-desc\" data-en=\"Identity, marital status and background checked for both sides before any introduction.\" data-es=\"Identidad, estado civil y antecedentes comprobados de ambas partes antes de cualquier presentación.\">Identity, marital status and background checked for both sides before any introduction.</p>\r\n        </div>\r\n      </div>\r\n      <!-- Bogotá -->\r\n      <div class=\"a-dest-card c-fade d2\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/Bogota.png\" alt=\"Consent\" class=\"a-dest-img\">\r\n        <div class=\"a-dest-overlay\">\r\n          <h3 class=\"a-dest-city\" data-en=\"Consent\" data-es=\"Consentimiento\">Consent</h3>\r\n          <p class=\"a-dest-desc\" data-en=\"No introduction happens without both people agreeing, case by case.\" data-es=\"Ninguna presentación ocurre sin que ambas personas acepten, caso por caso.\">No introduction happens without both people agreeing, case by case.</p>\r\n        </div>\r\n      </div>\r\n      <!-- Santa Marta -->\r\n      <div class=\"a-dest-card c-fade d3\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/SantaMarta.png\" alt=\"Accompaniment\" class=\"a-dest-img\">\r\n        <div class=\"a-dest-overlay\">\r\n          <h3 class=\"a-dest-city\" data-en=\"Accompaniment\" data-es=\"Acompañamiento\">Accompaniment</h3>\r\n          <p class=\"a-dest-desc\" data-en=\"The same matchmaker follows your process from approval to Cartagena.\" data-es=\"La misma matchmaker acompaña su proceso desde la aprobación hasta Cartagena.\">The same matchmaker follows your process from approval to Cartagena.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 3. LIFESTYLE / GASTRONOMY -->\r\n  <section class=\"sec\" style=\"padding-top:120px\">\r\n    <div class=\"wrap\">\r\n      \r\n      <div class=\"a-life-grid\">\r\n        <div class=\"a-life-content c-fade\">\r\n          <h2 class=\"heading-section\" style=\"margin-bottom:24px\" data-en-html=\"The Cartagena <span class='text-gold'>Programme</span>\" data-es-html=\"El programa en <span class='text-gold'>Cartagena</span>\">The Cartagena <span class=\"text-gold\">Programme</span></h2>\r\n          <p class=\"text-body\" style=\"font-size:1.05rem;line-height:1.8\" data-en=\"A private, accompanied programme in Cartagena: a welcome, organised meetings with the candidates selected for you, cultural activities and a closing dinner. The final agenda, venue and dates are confirmed in writing beforehand.\" data-es=\"Un programa privado y acompañado en Cartagena: bienvenida, encuentros organizados con las candidatas seleccionadas para usted, actividades culturales y una cena de cierre. La agenda, la sede y las fechas se confirman por escrito antes.\">A private, accompanied programme in Cartagena: a welcome, organised meetings with the candidates selected for you, cultural activities and a closing dinner. The final agenda, venue and dates are confirmed in writing beforehand.</p>\r\n        </div>\r\n        <div class=\"a-life-img-wrap c-fade d1\">\r\n          <img src=\"https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?q=80&w=800\" alt=\"Closing dinner\" class=\"a-life-img\">\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"a-life-grid\" style=\"margin-bottom:0\">\r\n        <div class=\"a-life-img-wrap c-fade\">\r\n          <img src=\"https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=800\" alt=\"A quiet setting\" class=\"a-life-img\">\r\n        </div>\r\n        <div class=\"a-life-content c-fade d1\">\r\n          <h2 class=\"heading-section\" style=\"margin-bottom:24px\" data-en-html=\"A Considered <span class='text-gold'>Setting</span>\" data-es-html=\"Un entorno <span class='text-gold'>cuidado</span>\">A Considered <span class=\"text-gold\">Setting</span></h2>\r\n          <p class=\"text-body\" style=\"font-size:1.05rem;line-height:1.8\" data-en=\"We choose quiet, safe settings so you can focus on the person across from you. Zafira’s team is present throughout the official programme.\" data-es=\"Elegimos espacios tranquilos y seguros para que usted pueda concentrarse en la persona que tiene enfrente. El equipo de Zafira está presente durante todo el programa oficial.\">We choose quiet, safe settings so you can focus on the person across from you. Zafira’s team is present throughout the official programme.</p>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 4. PHILOSOPHY -->\r\n  <section class=\"a-phil\">\r\n    <div class=\"wrap text-center\" style=\"max-width:750px;\">\r\n      <h2 class=\"a-phil-statement c-fade\" data-en=\"“Elegance is found in what is reserved.”\" data-es=\"“La elegancia se encuentra en lo que está reservado.”\">“Elegance is found in what is reserved.”</h2>\r\n      <p class=\"text-body c-fade d1\" style=\"font-size:1.1rem;line-height:1.8;margin-bottom:24px;\" data-en=\"We believe that some experiences are never meant for everyone. True luxury lies in selective access and environments where every detail is carefully considered.\" data-es=\"Creemos que algunas experiencias nunca están destinadas para todos. El verdadero lujo reside en el acceso selecto y en entornos donde cada detalle ha sido cuidadosamente considerado.\">We believe that some experiences are never meant for everyone. True luxury lies in selective access and environments where every detail is carefully considered.</p>\r\n      <p class=\"text-body c-fade d2\" style=\"font-size:1.1rem;line-height:1.8;margin-bottom:40px;\" data-en=\"At Zafira, access is intentional. Because we know that the right environment has the power to change a life.\" data-es=\"En Zafira, el acceso es intencional. Porque sabemos que el entorno adecuado tiene el poder de cambiar una vida.\">At Zafira, access is intentional. Because we know that the right environment has the power to change a life.</p>\r\n      <p class=\"text-body c-fade d3\" style=\"color:var(--gold);letter-spacing:0.05em;text-transform:uppercase;font-size:0.9rem\" data-en=\"The Philosophy of Zafira\" data-es=\"La Filosofía de Zafira\">The Philosophy of Zafira</p>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 5. CTA -->\r\n  <section class=\"sec text-center\" style=\"padding-bottom:120px\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section c-fade\" style=\"margin-bottom:40px\" data-en-html=\"Enter The <span class='text-gold'>Experience</span>\" data-es-html=\"Ingresa a la <span class='text-gold'>Experiencia</span>\">Enter The <span class=\"text-gold\">Experience</span></h2>\r\n      <div class=\"c-fade d1\">\r\n        <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"btn-gold\" style=\"padding:18px 50px;font-size:1rem;letter-spacing:0.05em\" data-en=\"Request Private Access\" data-es=\"Solicitar Acceso Privado\">Request Private Access</a>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n</main>\r\n\r\n<footer class=\"footer\"> \r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-en=\"Privacy Policy\" data-es=\"Privacy Policy\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\"\r\n     data-en=\"Zafira is not a dating platform. We create exclusive matching experiences through private events, verified profiles, and intentional connections. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\"\r\n     \r\n     data-es=\"Zafira no es una plataforma de citas. Creamos experiencias exclusivas de matching mediante eventos privados, perfiles verificados y conexiones intencionales. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">\r\n     \r\n     Zafira is not a dating platform. We create exclusive matching experiences through private events, verified profiles, and intentional connections. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\r\n  </p>\r\n</footer>\r\n\r\n<script>\r\n/* Trigger animations on scroll */\r\nconst obs=new IntersectionObserver(e=>{\r\n  e.forEach(x=>{\r\n    if(x.isIntersecting){\r\n      x.target.classList.add('vis');\r\n      obs.unobserve(x.target);\r\n    }\r\n  });\r\n},{threshold:.15});\r\n\r\ndocument.querySelectorAll('.c-fade').forEach(el=>obs.observe(el));\r\n\r\n/* Trigger hero immediately */\r\nsetTimeout(()=>{\r\n  const hero = document.getElementById('about-hero');\r\n  if(hero) hero.classList.add('vis');\r\n}, 100);\r\n</script>\r\n</body>\r\n</html>\r\n"
