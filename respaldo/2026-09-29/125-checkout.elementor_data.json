     "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Evaluation &amp; Verification | ZAFIRA</title>\r\n<meta name=\"description\" content=\"USD 400 evaluation and verification payment. Not a reservation and not part of the programme.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n\r\n<!-- Motor de idioma EN/ES -->\r\n<script>\r\n(function(){\r\n  function getLang(){ return localStorage.getItem('zafiraLang')||'en'; }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){ el.textContent=el.getAttribute('data-'+lang); });\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){ el.innerHTML=el.getAttribute('data-'+lang+'-html'); });\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){ el.placeholder=el.getAttribute('data-'+lang+'-ph'); });\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){ btn.classList.toggle('active', btn.getAttribute('data-lang')===lang); });\r\n  }\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n  document.addEventListener('DOMContentLoaded',function(){applyLang(getLang());});\r\n})();\r\n</script>\r\n\r\n<!-- PayPal SDK — Client ID real de producción -->\r\n<script src=\"https://www.paypal.com/sdk/js?client-id=BAAzqis0tuzMQJEKfHmp7qvmSH_3N-753g2mkKl-Bl84WrcRIOu9CFz7Kv72rD059Mi3TRAEnAEXKgM5Rs&components=hosted-buttons&disable-funding=venmo&currency=USD\"></script>\r\n\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\">\r\n      <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA\r\n    </a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <!-- ✅ MODIFICADO: apunta al formulario de registro primero -->\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\">\r\n        <button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n        <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n      </div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <!-- ✅ MODIFICADO: apunta al formulario de registro primero (mobile) -->\r\n    <a href=\"https://zafiramatchagency.com/caballeros/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\">\r\n      <button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n      <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n    </div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\r\n  <section class=\"sec\">\r\n    <div style=\"max-width:760px;margin:0 auto\">\r\n\r\n      <h1 class=\"heading-display text-center fade\"\r\n          data-en-html=\"Evaluation &amp; <span class='text-gold'>Verification</span>\"\r\n          data-es-html=\"Evaluación y <span class='text-gold'>Verificación</span>\">\r\n        Evaluation &amp; <span class=\"text-gold\">Verification</span>\r\n      </h1>\r\n      <div style=\"height:32px\"></div>\r\n\r\n      <div class=\"grid-2\" style=\"gap:32px\" id=\"checkoutGrid\">\r\n\r\n        <!-- Columna izquierda: resumen del pedido -->\r\n        <div class=\"fade d1\">\r\n          <div class=\"info-block\">\r\n            <h2 style=\"font-family:var(--ff-d);font-size:1.1rem;margin-bottom:16px\"\r\n                data-en=\"Order Summary\" data-es=\"Resumen del Pedido\">Order Summary</h2>\r\n            <div style=\"display:flex;justify-content:space-between;margin-bottom:10px\">\r\n              <span class=\"text-body\" data-en=\"Plan\" data-es=\"Plan\">Plan</span>\r\n              <span style=\"color:var(--gold);font-weight:600\" id=\"planName\">—</span>\r\n            </div>\r\n            <div class=\"divider\" style=\"width:100%;margin:14px 0\"></div>\r\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline\">\r\n              <span class=\"text-body\" data-en=\"Evaluation &amp; verification\" data-es=\"Evaluación y verificación\">Evaluation &amp; verification</span>\r\n              <span style=\"font-size:1.6rem;font-weight:700\">$400\r\n                <span style=\"font-size:.75rem;font-weight:400;color:var(--gray)\">USD</span>\r\n              </span>\r\n            </div>\r\n            <p class=\"text-legal\" style=\"margin-top:16px\"\r\n               data-en=\"Covers the study, the evaluation and the background verification. It is not a reservation and is not part of the USD 13,000 programme; non-refundable once the evaluation begins.\"\r\n               data-es=\"Cubre el estudio, la evaluación y la verificación de antecedentes. No es una reserva de cupo ni parte de los USD 13.000 del programa; no es reembolsable una vez iniciada la evaluación.\"> Covers the study, the evaluation and the background verification. It is not a reservation and is not part of the USD 13,000 programme; non-refundable once the evaluation begins. </p>\r\n          </div>\r\n          <div style=\"display:flex;align-items:center;gap:8px;margin-top:14px;font-size:.72rem;color:rgba(255,255,255,.3)\">\r\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\">\r\n              <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\r\n              <path d=\"M9 12l2 2 4-4\"/>\r\n            </svg>\r\n            <span data-en=\"Secured by PayPal · Buyer Protection included\"\r\n                  data-es=\"Asegurado por PayPal · Protección al comprador incluida\">\r\n              Secured by PayPal · Buyer Protection included\r\n            </span>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Columna derecha: formulario + botón PayPal -->\r\n        <div class=\"fade d2\">\r\n          <div class=\"info-block\">\r\n            <h2 style=\"font-family:var(--ff-d);font-size:1.1rem;margin-bottom:20px\"\r\n                data-en=\"Your Information\" data-es=\"Tu Información\">Your Information</h2>\r\n\r\n            <!-- Campo: Nombre completo -->\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" data-en=\"Full Name\" data-es=\"Nombre Completo\">Full Name</label>\r\n              <input type=\"text\" class=\"form-input\" id=\"chkName\"\r\n                     data-en-ph=\"As it appears on your ID\"\r\n                     data-es-ph=\"Como aparece en tu documento\"\r\n                     placeholder=\"As it appears on your ID\">\r\n            </div>\r\n\r\n            <!-- Campo: Correo electrónico -->\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" data-en=\"Email Address\" data-es=\"Correo Electrónico\">Email Address</label>\r\n              <input type=\"email\" class=\"form-input\" id=\"chkEmail\"\r\n                     placeholder=\"your@email.com\">\r\n            </div>\r\n\r\n            <div class=\"divider\" style=\"width:100%;margin:20px 0\"></div>\r\n\r\n            <p class=\"text-body\" style=\"font-size:.8rem;margin-bottom:16px;text-align:center\"\r\n               data-en=\"Complete your $400 payment securely via PayPal\"\r\n               data-es=\"Completa tu pago de $400 de forma segura por PayPal\">\r\n              Complete your $400 payment securely via PayPal\r\n            </p>\r\n\r\n            <!-- Botón PayPal — se renderiza aquí automáticamente -->\r\n            <div id=\"paypal-container-6GYCZEY5GZ5PC\"></div>\r\n\r\n            <!-- Aviso legal -->\r\n            <p class=\"text-legal text-center\" style=\"margin-top:16px\"\r\n               data-en-html=\"Non-refundable once verification begins. By paying you accept our <a href='https://zafiramatchagency.com/privacidad/' style='color:var(--gold);text-decoration:underline'>Terms &amp; Conditions</a>.\"\r\n               data-es-html=\"No reembolsable una vez iniciada la verificación. Al pagar aceptas nuestros <a href='https://zafiramatchagency.com/privacidad-es/' style='color:var(--gold);text-decoration:underline'>Términos y Condiciones</a>.\">\r\n              Non-refundable once verification begins.\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n      </div>\r\n\r\n      <!-- Mensaje de éxito — oculto hasta que PayPal confirme el pago -->\r\n      <div id=\"paymentSuccess\" style=\"display:none;text-align:center;padding:60px 20px;border:1px solid rgba(201,168,76,.2);border-radius:14px;background:rgba(201,168,76,.03);margin-top:32px\">\r\n        <div style=\"width:64px;height:64px;border:2px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px\">\r\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"2\">\r\n            <path d=\"M20 6L9 17l-5-5\"/>\r\n          </svg>\r\n        </div>\r\n        <h2 class=\"heading-sub\" data-en=\"Payment Confirmed\" data-es=\"Pago Confirmado\">Payment Confirmed</h2>\r\n        <p class=\"text-body\" style=\"margin-top:8px;max-width:400px;margin-left:auto;margin-right:auto\"\r\n           data-en=\"Thank you! Our team will contact you within 48 business hours to begin your verification process.\"\r\n           data-es=\"¡Gracias! Nuestro equipo te contactará dentro de 48 horas hábiles para iniciar tu proceso de verificación.\">\r\n          Thank you! Our team will contact you within 48 business hours.\r\n        </p>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n</main>\r\n\r\n<footer class=\"footer\">\r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-en=\"Privacy Policy\" data-es=\"Privacy Policy\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Política de Privacidad\" data-es=\"Política de Privacidad\">Política de Privacidad</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\"\r\n     data-en=\"Zafira is not a dating platform. We are a matrimonial consultancy with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\"\r\n     data-es=\"Zafira no es una plataforma de citas. Somos una consultoría matrimonial con procesos verificados. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">\r\n    Zafira is not a dating platform. We are a matrimonial consultancy with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\r\n  </p>\r\n</footer>\r\n\r\n<script>\r\n/* Animaciones de scroll */\r\nconst obs=new IntersectionObserver(e=>{\r\n  e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})\r\n},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\n\r\n/* Plan seleccionado desde la página de planes */\r\nconst plan=sessionStorage.getItem('zafira_plan');\r\nconst nm=document.getElementById('planName');\r\n/* ya no hay niveles: un solo programa */\nnm.textContent=(window.zafiraGetLang&&window.zafiraGetLang()==='es')\n  ? 'El Programa ($13,000 USD)' : 'The Programme ($13,000 USD)';\r\n\r\n/* ✅ NUEVO: Pre-llenar nombre y email con datos del formulario de registro */\r\nconst savedName  = sessionStorage.getItem('zafira_name');\r\nconst savedEmail = sessionStorage.getItem('zafira_email');\r\nif(savedName)  document.getElementById('chkName').value  = savedName;\r\nif(savedEmail) document.getElementById('chkEmail').value = savedEmail;\r\n\r\n/* URL del webhook de Make */\r\nvar WEBHOOK_URL='[WEBHOOK-MAKE-REDACTADO]';\r\n\r\n/* Se ejecuta cuando PayPal confirma el pago exitosamente */\r\nfunction onPayPalSuccess(data){\r\n  var name  = document.getElementById('chkName').value.trim();\r\n  var email = document.getElementById('chkEmail').value.trim();\r\n\r\n  /* Enviar datos del pago a Make → Make envía email de confirmación */\r\n  fetch(WEBHOOK_URL,{\r\n    method:  'POST',\r\n    headers: {'Content-Type':'application/json'},\r\n    body: JSON.stringify({\r\n      formType:      'payment',\r\n      name:          name,\r\n      email:         email,\r\n      amount:        '400',\r\n      currency:      'USD',\r\n      plan:          sessionStorage.getItem('zafira_plan')||'unknown',\r\n      paypalOrderId: data.orderID||data.id||'N/A',\r\n      source:        window.location.href,\r\n      timestamp:     new Date().toISOString(),\r\n      lang:          window.zafiraGetLang?window.zafiraGetLang():'en'\r\n    })\r\n  }).catch(function(err){ console.warn('Webhook error:',err); });\r\n\r\n  /* limpiar sessionStorage de datos del registro ya usados */\r\n  sessionStorage.removeItem('zafira_name');\r\n  sessionStorage.removeItem('zafira_email');\r\n\r\n  /* Ocultar formulario y mostrar mensaje de éxito */\r\n  document.getElementById('checkoutGrid').style.display='none';\r\n  document.getElementById('paymentSuccess').style.display='block';\r\n}\r\n\r\n/* Renderizar el botón PayPal Hosted Button */\r\npaypal.HostedButtons({\r\n  hostedButtonId: \"6GYCZEY5GZ5PC\",\r\n\r\n  /* Validar nombre y email ANTES de abrir PayPal */\r\n  onClick: function(){\r\n    var name  = document.getElementById('chkName').value.trim();\r\n    var email = document.getElementById('chkEmail').value.trim();\r\n    if(!name||!email){\r\n      alert(window.zafiraGetLang&&window.zafiraGetLang()==='es'\r\n        ?'Por favor completa tu nombre y correo primero.'\r\n        :'Please fill in your name and email first.');\r\n      return false;\r\n    }\r\n  },\r\n\r\n  /* Pago aprobado por PayPal → disparar webhook */\r\n  onApprove: function(data){\r\n    onPayPalSuccess(data);\r\n  },\r\n\r\n  /* Error en el pago */\r\n  onError: function(err){\r\n    console.error('PayPal error:',err);\r\n    alert(window.zafiraGetLang&&window.zafiraGetLang()==='es'\r\n      ?'Hubo un error con el pago. Por favor intenta de nuevo.'\r\n      :'There was a payment error. Please try again.');\r\n  }\r\n\r\n}).render(\"#paypal-container-6GYCZEY5GZ5PC\");\r\n</script>\r\n</body>\r\n</html>"
