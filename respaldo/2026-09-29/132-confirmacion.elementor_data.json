     "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Payment Received | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Your Zafira evaluation payment has been received. Next steps of your process.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"css/styles.css\">\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'en';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\"><img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA</a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <a href=\"https://zafiramatchagency.com/checkout/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <a href=\"https://zafiramatchagency.com/checkout/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\r\n  <section class=\"sec\">\r\n    <div class=\"wrap-sm text-center\">\r\n      <!-- Success icon -->\r\n      <div class=\"fade\" style=\"width:72px;height:72px;border:2px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 28px\">\r\n        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"/></svg>\r\n      </div>\r\n      <h1 class=\"heading-display fade d1\"><span data-en=\"Welcome\" data-es=\"Bienvenido\">Welcome</span><span id=\"nameSpan\"></span>.</h1>\r\n      <p class=\"text-body fade d2\" style=\"margin-bottom:8px\" data-en=\"We have received your payment for the evaluation and verification.\" data-es=\"Hemos recibido tu pago de la evaluación y verificación.\">We have received your payment for the evaluation and verification.</p>\r\n      <div class=\"fade d3\" style=\"margin:28px auto\">\r\n        <span class=\"pill pill-gold\" id=\"planPill\">—</span>\r\n      </div>\r\n\r\n      <!-- Next Steps -->\r\n      <div class=\"info-block fade d4\" style=\"text-align:left;margin-top:36px\">\r\n        <h2 style=\"font-family:var(--ff-d);font-size:1.1rem;margin-bottom:16px\" data-en=\"Next Steps\" data-es=\"Próximos Pasos\">Next Steps</h2>\r\n        <ol style=\"list-style:none;counter-reset:ns\">\r\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">1.</span><span class=\"text-body\" data-en=\"Check your email for a secure link to complete your full registration form. This link is valid for 72 hours.\" data-es=\"Revisa tu correo electrónico para un enlace seguro para completar tu formulario de registro. Este enlace es válido por 72 horas.\">Check your email for a secure link to complete your full registration form. This link is valid for 72 hours.</span></li>\r\n          <li style=\"display:flex;gap:12px;margin-bottom:14px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">2.</span><span class=\"text-body\" data-en=\"Complete the registration form with accurate information. This data is used for your background verification and candidate selection.\" data-es=\"Completa el formulario de registro con información precisa. Estos datos se utilizan para tu verificación de antecedentes y selección de candidatas.\">Complete the registration form with accurate information. This data is used for your background verification and candidate selection.</span></li>\r\n          <li style=\"display:flex;gap:12px\"><span style=\"color:var(--gold);font-weight:700;font-size:.9rem\">3.</span><span class=\"text-body\" data-en=\"Your assigned advisor will contact you within 48 business hours to schedule your initial consultation.\" data-es=\"Tu asesor asignado te contactará dentro de 48 horas hábiles para programar tu consulta inicial.\">Your assigned advisor will contact you within 48 business hours to schedule your initial consultation.</span></li>\r\n        </ol>\r\n      </div>\r\n\r\n      <!-- Timeline -->\r\n      <div class=\"fade d5\" style=\"margin-top:40px\">\r\n        <h3 style=\"font-family:var(--ff-d);font-size:1.05rem;margin-bottom:24px\" data-en=\"Your Journey\" data-es=\"Tu Camino\">Your Journey</h3>\r\n        <div style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:10px\">\r\n          <div style=\"border:1px solid var(--gold);background:rgba(201,168,76,.08);padding:16px 8px;text-align:center;border-radius:8px\">\r\n            <div style=\"font-family:var(--ff-d);font-size:1.3rem;font-weight:700;color:var(--gold);margin-bottom:4px\">1 ✓</div>\r\n            <p style=\"font-size:.65rem;color:var(--gray)\" data-en=\"Evaluation\" data-es=\"Evaluación\">Evaluation</p>\r\n          </div>\r\n          <div style=\"border:1px solid rgba(201,168,76,.1);padding:16px 8px;text-align:center;border-radius:8px\">\r\n            <div style=\"font-family:var(--ff-d);font-size:1.3rem;font-weight:700;color:rgba(255,255,255,.2);margin-bottom:4px\">2</div>\r\n            <p style=\"font-size:.65rem;color:var(--gray)\" data-en=\"Approval\" data-es=\"Aprobación\">Approval</p>\r\n          </div>\r\n          <div style=\"border:1px solid rgba(201,168,76,.1);padding:16px 8px;text-align:center;border-radius:8px\">\r\n            <div style=\"font-family:var(--ff-d);font-size:1.3rem;font-weight:700;color:rgba(255,255,255,.2);margin-bottom:4px\">3</div>\r\n            <p style=\"font-size:.65rem;color:var(--gray)\" data-en=\"Programme\" data-es=\"Programa\">Programme</p>\r\n          </div>\r\n          <div style=\"border:1px solid rgba(201,168,76,.1);padding:16px 8px;text-align:center;border-radius:8px\">\r\n            <div style=\"font-family:var(--ff-d);font-size:1.3rem;font-weight:700;color:rgba(255,255,255,.2);margin-bottom:4px\">4</div>\r\n            <p style=\"font-size:.65rem;color:var(--gray)\" data-en=\"Introductions\" data-es=\"Presentaciones\">Introductions</p>\r\n          </div>\r\n          <div style=\"border:1px solid rgba(201,168,76,.1);padding:16px 8px;text-align:center;border-radius:8px\">\r\n            <div style=\"font-family:var(--ff-d);font-size:1.3rem;font-weight:700;color:rgba(255,255,255,.2);margin-bottom:4px\">5</div>\r\n            <p style=\"font-size:.65rem;color:var(--gray)\" data-en=\"Cartagena (Oct/Nov 2026, TBC)\" data-es=\"Cartagena (oct/nov 2026, por confirmar)\">Cartagena (Oct/Nov 2026, TBC)</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <p class=\"text-legal fade d6\" style=\"margin-top:28px\" data-en=\"If you do not receive the registration email within 15 minutes, please check your spam folder.\" data-es=\"Si no recibes el correo de registro dentro de 15 minutos, revisa tu carpeta de spam.\">If you do not receive the registration email within 15 minutes, please check your spam folder.</p>\r\n    </div>\r\n  </section>\r\n</main>\r\n\r\n<footer class=\"footer\">\r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-en=\"Privacy Policy\" data-es=\"Privacy Policy\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Política de Privacidad\" data-es=\"Política de Privacidad\">Política de Privacidad</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\" data-en=\"Zafira is not a dating platform. We are a matrimonial consultancy with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\" data-es=\"Zafira no es una plataforma de citas. Somos una consultoría matrimonial con procesos verificados. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">Zafira is not a dating platform. We are a matrimonial consultancy with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com</p>\r\n</footer>\r\n\r\n<script>\r\nconst obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\nconst name=sessionStorage.getItem('zafira_client_name');\r\nconst plan=sessionStorage.getItem('zafira_plan');\r\nif(name)document.getElementById('nameSpan').textContent=', '+name;\r\nvar _pp=document.getElementById('planPill');\n  if(_pp) _pp.textContent=(window.zafiraGetLang&&window.zafiraGetLang()==='es')?'Programa Zafira':'Zafira Programme';\r\n</script>\r\n</body>\r\n</html>\r\n"
