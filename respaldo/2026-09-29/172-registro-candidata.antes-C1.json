     "settings": {
      "html": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Registro de Candidata | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Completa tu registro como candidata verificada en Zafira. Proceso seguro, confidencial y acompañado.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<style>\r\n  /* CSS correction for horizontal cut-off in select fields */\r\n  .form-select {\r\n    padding-right: 40px !important; /* Prevent text from overlapping the arrow */\r\n    white-space: normal !important; /* Allow wrapping */\r\n    word-wrap: break-word !important;\r\n    height: auto !important; \r\n    min-height: 50px !important;\r\n    overflow: visible !important;\r\n  }\r\n  #phoneCode {\r\n    white-space: nowrap !important;\r\n    text-overflow: ellipsis !important;\r\n    overflow: hidden !important;\r\n    padding-right: 28px !important;\r\n  }\r\n</style>\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'en';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n<!-- Navbar -->\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\">\r\n      <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA\r\n    </a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <div class=\"lang-switch\">\r\n        <button class=\"lang-btn\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n        <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n      </div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\">\r\n      <button class=\"lang-btn\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n      <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n    </div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\r\n  <section class=\"sec\">\r\n    <div class=\"wrap-md\">\r\n      <h1 class=\"heading-display text-center fade\" data-es-html=\"Registro de <span class='text-gold'>Candidata</span>\" data-en-html=\"Candidate <span class='text-gold'>Registration</span>\">Registro de <span class=\"text-gold\">Candidata</span></h1>\r\n      <p class=\"text-body text-center fade d1\" style=\"margin-bottom:40px\" data-es=\"Toda la información proporcionada es confidencial y será utilizada exclusivamente para verificación y selección de candidatos compatibles.\" data-en=\"All information provided is confidential and will be used exclusively for verification and selection of compatible candidates.\">Toda la información proporcionada es confidencial y será utilizada exclusivamente para verificación y selección de candidatos compatibles.</p>\r\n\r\n      <!-- Step indicator -->\r\n      <div class=\"steps-bar fade d2\" id=\"stepBar\"></div>\r\n\r\n      <!-- Form container -->\r\n      <div class=\"info-block fade d3\" id=\"formWrap\">\r\n\r\n        <!-- Step 1: Información Personal -->\r\n        <div class=\"form-step\" id=\"step1\">\r\n          <h2 class=\"heading-sub text-gold\" style=\"margin-bottom:24px\" data-es=\"Información Personal\" data-en=\"Personal Information\">Información Personal</h2>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Nombre Completo\" data-en=\"Full Name\">Nombre Completo</label>\r\n            <input type=\"text\" class=\"form-input\" data-es-ph=\"Como aparece en tu documento de identidad\" data-en-ph=\"As it appears on your official ID\" placeholder=\"Como aparece en tu documento de identidad\" id=\"fullName\">\r\n          </div>\r\n          <div class=\"grid-2\">\r\n            <div class=\"form-group\"><label class=\"form-label\" data-es=\"Edad\" data-en=\"Age\">Edad</label><input type=\"number\" class=\"form-input\" placeholder=\"18+\" min=\"18\" id=\"age\"></div>\r\n            <div class=\"form-group\"><label class=\"form-label\" data-es=\"Ciudad\" data-en=\"City\">Ciudad</label><input type=\"text\" class=\"form-input\" data-es-ph=\"Ciudad de residencia\" data-en-ph=\"City of residence\" placeholder=\"Ciudad de residencia\" id=\"city\"></div>\r\n          </div>\r\n          <div class=\"form-group\"><label class=\"form-label\" data-es=\"Departamento\" data-en=\"State / Province\">Departamento</label><input type=\"text\" class=\"form-input\" data-es-ph=\"Departamento\" data-en-ph=\"State or province\" placeholder=\"Departamento\" id=\"department\"></div>\r\n          <div class=\"form-group\"><label class=\"form-label\" data-es=\"País\" data-en=\"Country\">País</label>\r\n            <select class=\"form-input form-select\" id=\"country\" style=\"width: 100%;\">\r\n              <option>Colombia</option><option>Venezuela</option><option>Ecuador</option><option>Perú</option><option>México</option><option data-es=\"Otro\" data-en=\"Other\">Otro</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"form-group\"><label class=\"form-label\" data-es=\"Correo Electrónico\" data-en=\"Email Address\">Correo Electrónico</label><input type=\"email\" class=\"form-input\" data-es-ph=\"tu@correo.com\" data-en-ph=\"your@email.com\" placeholder=\"tu@correo.com\" id=\"email\"></div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Teléfono / WhatsApp\" data-en=\"Phone / WhatsApp\">Teléfono / WhatsApp</label>\r\n            <div style=\"display: flex; gap: 8px; width: 100%;\">\r\n              <select class=\"form-input form-select\" id=\"phoneCode\" style=\"width: 130px; flex-shrink: 0; padding-right: 24px;\">\r\n                <option value=\"\" data-en=\"Code\" data-es=\"Cód.\">Code</option>\r\n                <optgroup label=\"America\">\r\n                  <option value=\"+1\">US/CA (+1)</option>\r\n                  <option value=\"+52\">Mexico (+52)</option>\r\n                  <option value=\"+57\">Colombia (+57)</option>\r\n                  <option value=\"+55\">Brazil (+55)</option>\r\n                  <option value=\"+54\">Argentina (+54)</option>\r\n                  <option value=\"+56\">Chile (+56)</option>\r\n                  <option value=\"+51\">Peru (+51)</option>\r\n                  <option value=\"+58\">Venezuela (+58)</option>\r\n                  <option value=\"+593\">Ecuador (+593)</option>\r\n                  <option value=\"+507\">Panama (+507)</option>\r\n                  <option value=\"+506\">Costa Rica (+506)</option>\r\n                  <option value=\"+502\">Guatemala (+502)</option>\r\n                  <option value=\"+503\">El Salvador (+503)</option>\r\n                  <option value=\"+504\">Honduras (+504)</option>\r\n                  <option value=\"+505\">Nicaragua (+505)</option>\r\n                  <option value=\"+598\">Uruguay (+598)</option>\r\n                  <option value=\"+595\">Paraguay (+595)</option>\r\n                  <option value=\"+591\">Bolivia (+591)</option>\r\n                  <option value=\"+1\">Dominican Rep. (+1)</option>\r\n                  <option value=\"+53\">Cuba (+53)</option>\r\n                </optgroup>\r\n                <optgroup label=\"Europe\">\r\n                  <option value=\"+34\">Spain (+34)</option>\r\n                  <option value=\"+44\">UK (+44)</option>\r\n                  <option value=\"+49\">Germany (+49)</option>\r\n                  <option value=\"+33\">France (+33)</option>\r\n                  <option value=\"+39\">Italy (+39)</option>\r\n                  <option value=\"+351\">Portugal (+351)</option>\r\n                  <option value=\"+31\">Netherlands (+31)</option>\r\n                  <option value=\"+32\">Belgium (+32)</option>\r\n                  <option value=\"+41\">Switzerland (+41)</option>\r\n                  <option value=\"+46\">Sweden (+46)</option>\r\n                  <option value=\"+47\">Norway (+47)</option>\r\n                  <option value=\"+45\">Denmark (+45)</option>\r\n                  <option value=\"+353\">Ireland (+353)</option>\r\n                  <option value=\"+43\">Austria (+43)</option>\r\n                  <option value=\"+48\">Poland (+48)</option>\r\n                  <option value=\"+7\">Russia (+7)</option>\r\n                </optgroup>\r\n                <optgroup label=\"Asia & Oceania\">\r\n                  <option value=\"+86\">China (+86)</option>\r\n                  <option value=\"+91\">India (+91)</option>\r\n                  <option value=\"+81\">Japan (+81)</option>\r\n                  <option value=\"+82\">South Korea (+82)</option>\r\n                  <option value=\"+61\">Australia (+61)</option>\r\n                  <option value=\"+64\">New Zealand (+64)</option>\r\n                  <option value=\"+65\">Singapore (+65)</option>\r\n                  <option value=\"+60\">Malaysia (+60)</option>\r\n                  <option value=\"+62\">Indonesia (+62)</option>\r\n                  <option value=\"+63\">Philippines (+63)</option>\r\n                  <option value=\"+66\">Thailand (+66)</option>\r\n                  <option value=\"+84\">Vietnam (+84)</option>\r\n                </optgroup>\r\n                <optgroup label=\"Middle East & Africa\">\r\n                  <option value=\"+971\">UAE (+971)</option>\r\n                  <option value=\"+966\">Saudi Arabia (+966)</option>\r\n                  <option value=\"+972\">Israel (+972)</option>\r\n                  <option value=\"+90\">Turkey (+90)</option>\r\n                  <option value=\"+20\">Egypt (+20)</option>\r\n                  <option value=\"+27\">South Africa (+27)</option>\r\n                  <option value=\"+234\">Nigeria (+234)</option>\r\n                  <option value=\"+254\">Kenya (+254)</option>\r\n                  <option value=\"+212\">Morocco (+212)</option>\r\n                </optgroup>\r\n              </select>\r\n              <input type=\"tel\" class=\"form-input\" data-en-ph=\"(555) 123-4567\" data-es-ph=\"300 123 4567\" placeholder=\"300 123 4567\" id=\"phone\" style=\"flex-grow: 1; min-width: 0;\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Step 2: Estado Civil y Profesión -->\r\n        <div class=\"form-step\" id=\"step2\" style=\"display:none\">\r\n          <h2 class=\"heading-sub text-gold\" style=\"margin-bottom:24px\" data-es=\"Estado Civil y Profesión\" data-en=\"Marital Status & Profession\">Estado Civil y Profesión</h2>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Estado Civil Actual\" data-en=\"Current Marital Status\">Estado Civil Actual</label>\r\n            <select class=\"form-input form-select\" id=\"marital\" onchange=\"checkMarried(this.value)\" style=\"width: 100%;\">\r\n              <option value=\"\" data-es=\"Seleccionar estado\" data-en=\"Select status\">Seleccionar estado</option><option data-es=\"Soltera\" data-en=\"Single\">Soltera</option><option data-es=\"Divorciada\" data-en=\"Divorced\">Divorciada</option><option data-es=\"Viuda\" data-en=\"Widowed\">Viuda</option><option data-es=\"Casada\" data-en=\"Married\">Casada</option>\r\n            </select>\r\n          </div>\r\n          <div id=\"marriedBlock\" style=\"display:none;border:1px solid rgba(239,68,68,.25);background:rgba(239,68,68,.04);padding:18px;border-radius:8px;margin-bottom:16px\">\r\n            <p style=\"font-size:.85rem;color:#f87171;font-weight:500\" data-es=\"Lo sentimos — nuestro servicio está disponible únicamente para personas solteras, divorciadas o viudas.\" data-en=\"We're sorry — our service is available exclusively for single, divorced, or widowed individuals.\">Lo sentimos — nuestro servicio está disponible únicamente para personas solteras, divorciadas o viudas.</p>\r\n          </div>\r\n          <div class=\"form-group\"><label class=\"form-label\" data-es=\"¿Tienes hijos?\" data-en=\"Do you have children?\">¿Tienes hijos?</label>\r\n            <select class=\"form-input form-select\" id=\"children\" style=\"width: 100%;\"><option value=\"\" data-es=\"Seleccionar\" data-en=\"Select\">Seleccionar</option><option>No</option><option data-es=\"Sí, 1\" data-en=\"Yes, 1\">Sí, 1</option><option data-es=\"Sí, 2\" data-en=\"Yes, 2\">Sí, 2</option><option data-es=\"Sí, 3 o más\" data-en=\"Yes, 3 or more\">Sí, 3 o más</option></select>\r\n          </div>\r\n          <div class=\"form-group\"><label class=\"form-label\" data-es=\"Profesión / Ocupación\" data-en=\"Profession / Occupation\">Profesión / Ocupación</label><input type=\"text\" class=\"form-input\" data-es-ph=\"Tu profesión actual\" data-en-ph=\"Your current profession\" placeholder=\"Tu profesión actual\" id=\"profession\"></div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Nivel de Educación\" data-en=\"Education Level\">Nivel de Educación</label>\r\n            <select class=\"form-input form-select\" id=\"education\" style=\"width: 100%;\"><option value=\"\" data-es=\"Seleccionar nivel\" data-en=\"Select level\">Seleccionar nivel</option><option data-es=\"Bachillerato\" data-en=\"High School\">Bachillerato</option><option data-es=\"Técnico / Tecnológico\" data-en=\"Technical / Associate\">Técnico / Tecnológico</option><option data-es=\"Universidad / Pregrado\" data-en=\"University / Bachelor's\">Universidad / Pregrado</option><option data-es=\"Posgrado / Maestría\" data-en=\"Postgraduate / Master's\">Posgrado / Maestría</option></select>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Nivel de Inglés\" data-en=\"English Level\">Nivel de Inglés</label>\r\n            <select class=\"form-input form-select\" id=\"english\" style=\"width: 100%;\"><option value=\"\" data-es=\"Seleccionar nivel\" data-en=\"Select level\">Seleccionar nivel</option><option data-es=\"Básico\" data-en=\"Basic\">Básico</option><option data-es=\"Intermedio\" data-en=\"Intermediate\">Intermedio</option><option data-es=\"Avanzado\" data-en=\"Advanced\">Avanzado</option><option data-es=\"Nativo / Bilingüe\" data-en=\"Native / Bilingual\">Nativo / Bilingüe</option></select>\r\n          </div>\r\n\r\n          <!-- Social Media & Professional Presence -->\r\n          <h3 class=\"heading-section text-gold\" style=\"margin-top:40px; margin-bottom:20px; font-size:1.2rem; border-top:1px solid rgba(201,168,76,.15); padding-top:24px;\" data-en=\"Social Media & Professional Presence\" data-es=\"Presencia en Redes Sociales y Profesional\">Presencia en Redes Sociales y Profesional</h3>\r\n          <div class=\"grid-2\">\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" style=\"display:flex; justify-content:space-between;\">\r\n                <span>Instagram</span>\r\n                <span style=\"font-size:0.7rem; opacity:0.5;\" data-en=\"(Optional)\" data-es=\"(Opcional)\">(Opcional)</span>\r\n              </label>\r\n              <input type=\"url\" class=\"form-input\" placeholder=\"https://instagram.com/tuusuario\" id=\"socialInsta\">\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" style=\"display:flex; justify-content:space-between;\">\r\n                <span>LinkedIn</span>\r\n                <span style=\"font-size:0.7rem; opacity:0.5;\" data-en=\"(Optional)\" data-es=\"(Opcional)\">(Opcional)</span>\r\n              </label>\r\n              <input type=\"url\" class=\"form-input\" placeholder=\"https://linkedin.com/in/username\" id=\"socialLinked\">\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" style=\"display:flex; justify-content:space-between;\">\r\n                <span>Facebook</span>\r\n                <span style=\"font-size:0.7rem; opacity:0.5;\" data-en=\"(Optional)\" data-es=\"(Opcional)\">(Opcional)</span>\r\n              </label>\r\n              <input type=\"url\" class=\"form-input\" placeholder=\"https://facebook.com/tuusuario\" id=\"socialFb\">\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" style=\"display:flex; justify-content:space-between;\">\r\n                <span>X / Twitter</span>\r\n                <span style=\"font-size:0.7rem; opacity:0.5;\" data-en=\"(Optional)\" data-es=\"(Opcional)\">(Opcional)</span>\r\n              </label>\r\n              <input type=\"url\" class=\"form-input\" placeholder=\"https://x.com/tuusuario\" id=\"socialX\">\r\n            </div>\r\n            <div class=\"form-group\" style=\"grid-column: 1 / -1;\">\r\n              <label class=\"form-label\" style=\"display:flex; justify-content:space-between;\">\r\n                <span>TikTok</span>\r\n                <span style=\"font-size:0.7rem; opacity:0.5;\" data-en=\"(Optional)\" data-es=\"(Opcional)\">(Opcional)</span>\r\n              </label>\r\n              <input type=\"url\" class=\"form-input\" placeholder=\"https://tiktok.com/@username\" id=\"socialTiktok\">\r\n            </div>\r\n          </div>\r\n          <div class=\"info-block\" style=\"padding:16px 20px; margin-top:8px; margin-bottom:0; display:flex; gap:14px; align-items:flex-start; background:rgba(201,168,76,.03); border-color:rgba(201,168,76,.2);\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--gold)\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0; margin-top:2px\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\r\n            <p style=\"font-size:0.78rem; color:var(--gray); line-height:1.6; margin:0;\" data-en=\"Providing social media or professional profile information is entirely optional and is used solely for identity consistency, authenticity review, and profile verification purposes. Zafira respects applicant privacy and does not request access to private accounts, messages, or restricted content.\" data-es=\"Proporcionar información de redes sociales o perfiles profesionales es totalmente opcional y se utiliza únicamente para fines de coherencia de identidad, revisión de autenticidad y verificación de perfiles. Zafira respeta la privacidad del solicitante y no solicita acceso a cuentas privadas, mensajes ni contenido restringido.\">Proporcionar información de redes sociales o perfiles profesionales es totalmente opcional y se utiliza únicamente para fines de coherencia de identidad, revisión de autenticidad y verificación de perfiles. Zafira respeta la privacidad del solicitante y no solicita acceso a cuentas privadas, mensajes ni contenido restringido.</p>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Step 3: Expectativas -->\r\n        <div class=\"form-step\" id=\"step3\" style=\"display:none\">\r\n          <h2 class=\"heading-sub text-gold\" style=\"margin-bottom:24px\" data-es=\"Expectativas y Preferencias\" data-en=\"Expectations & Preferences\">Expectativas y Preferencias</h2>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"¿Qué buscas en un matrimonio?\" data-en=\"What are you looking for in a marriage?\">¿Qué buscas en un matrimonio?</label>\r\n            <div class=\"grid-2\" style=\"margin-top:8px\">\r\n              <label class=\"check-group\"><input type=\"checkbox\" value=\"Estabilidad emocional\"><span data-es=\"Estabilidad emocional\" data-en=\"Emotional stability\">Estabilidad emocional</span></label>\r\n              <label class=\"check-group\"><input type=\"checkbox\" value=\"Formar una familia\"><span data-es=\"Formar una familia\" data-en=\"Starting a family\">Formar una familia</span></label>\r\n              <label class=\"check-group\"><input type=\"checkbox\" value=\"Compañerismo\"><span data-es=\"Compañerismo\" data-en=\"Companionship\">Compañerismo</span></label>\r\n              <label class=\"check-group\"><input type=\"checkbox\" value=\"Crecimiento personal\"><span data-es=\"Crecimiento personal\" data-en=\"Personal growth\">Crecimiento personal</span></label>\r\n            </div>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Rango de Edad Preferido del Candidato\" data-en=\"Preferred Candidate Age Range\">Rango de Edad Preferido del Candidato</label>\r\n            <div class=\"grid-2\"><input type=\"number\" class=\"form-input\" data-es-ph=\"Mín (30)\" data-en-ph=\"Min (30)\" placeholder=\"Mín (30)\" min=\"30\" max=\"70\" id=\"ageMin\"><input type=\"number\" class=\"form-input\" data-es-ph=\"Máx (65)\" data-en-ph=\"Max (65)\" placeholder=\"Máx (65)\" min=\"30\" max=\"70\" id=\"ageMax\"></div>\r\n            <label class=\"check-group\" style=\"margin-top:12px\">\r\n              <input type=\"checkbox\" value=\"No age preference\" id=\"noAgePref\" onchange=\"document.getElementById('ageMin').disabled=this.checked; document.getElementById('ageMax').disabled=this.checked; if(this.checked){document.getElementById('ageMin').value=''; document.getElementById('ageMax').value='';}\">\r\n              <span data-es=\"La edad no es un factor determinante\" data-en=\"Age is not a determining factor\">La edad no es un factor determinante</span>\r\n            </label>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\" data-es=\"Cuéntanos sobre ti (máx. 300 caracteres)\" data-en=\"Tell us about yourself (max. 300 characters)\">Cuéntanos sobre ti (máx. 300 caracteres)</label>\r\n            <textarea class=\"form-input\" rows=\"3\" maxlength=\"300\" data-es-ph=\"Describe brevemente tus valores, intereses y lo que te hace única...\" data-en-ph=\"Briefly describe your values, interests, and what makes you unique...\" placeholder=\"Describe brevemente tus valores, intereses y lo que te hace única...\" id=\"about\" oninput=\"document.getElementById('charCount').textContent=this.value.length+'/300'\"></textarea>\r\n            <span style=\"font-size:.7rem;color:rgba(255,255,255,.2)\" id=\"charCount\">0/300</span>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Step 4: Consentimiento Legal -->\r\n        <div class=\"form-step\" id=\"step4\" style=\"display:none\">\r\n          <h2 class=\"heading-sub text-gold\" style=\"margin-bottom:24px\" data-es=\"Declaración Legal y Consentimiento\" data-en=\"Legal Declaration & Consent\">Declaración Legal y Consentimiento</h2>\r\n          <div class=\"info-block\" style=\"font-size:.85rem;color:var(--gray);line-height:1.7;margin-bottom:24px\" data-es=\"Declaro bajo juramento que la información suministrada es veraz y completa. Entiendo que cualquier inconsistencia detectada durante el proceso de verificación — incluyendo pero no limitado a: estado civil activo (casada), antecedentes penales no revelados o datos de identidad falsos — resultará en la anulación inmediata del proceso. Autorizo a Zafira a realizar la verificación de antecedentes civiles y penales bajo la legislación colombiana vigente.\" data-en=\"I declare under oath that the information provided is truthful and complete. I understand that any inconsistency detected during the verification process — including but not limited to: active marital status (married), undisclosed criminal records, or false identity data — will result in the immediate annulment of the process. I authorize Zafira to conduct civil and criminal background verification under current Colombian legislation.\">\r\n            Declaro bajo juramento que la información suministrada es veraz y completa. Entiendo que cualquier inconsistencia detectada durante el proceso de verificación — incluyendo pero no limitado a: estado civil activo (casada), antecedentes penales no revelados o datos de identidad falsos — resultará en la anulación inmediata del proceso. Autorizo a Zafira a realizar la verificación de antecedentes civiles y penales bajo la legislación colombiana vigente.\r\n          </div>\r\n          <div style=\"display:flex;flex-direction:column;gap:12px\">\r\n            <label class=\"check-group\" id=\"chkTerms\">\r\n              <input type=\"checkbox\" id=\"acceptTerms\">\r\n              <span data-es-html=\"Autorizo de manera previa, expresa e informada a Zafira Limited Edition S.A.S. (NIT 902064015-7) para tratar mis datos personales con el fin de evaluar mi registro, verificar mi identidad y contactarme, conforme a la Ley 1581 de 2012 y a la <a href='https://zafiramatchagency.com/privacidad-es/' style='color:var(--gold);text-decoration:underline' target='_blank'>Política de Privacidad</a>. Sé que puedo conocer, actualizar, rectificar y suprimir mis datos y revocar esta autorización escribiendo a business@zafiramatchagency.com.\" data-en-html=\"I give Zafira Limited Edition S.A.S. (NIT 902064015-7) my prior, express and informed authorisation to process my personal data in order to review my registration, verify my identity and contact me, under Colombian Law 1581 of 2012 and the <a href='https://zafiramatchagency.com/privacidad/' style='color:var(--gold);text-decoration:underline' target='_blank'>Privacy Policy</a>. I know I can access, update, correct and delete my data and withdraw this authorisation by writing to business@zafiramatchagency.com.\">Autorizo de manera previa, expresa e informada a Zafira Limited Edition S.A.S. (NIT 902064015-7) para tratar mis datos personales con el fin de evaluar mi registro, verificar mi identidad y contactarme, conforme a la Ley 1581 de 2012 y a la <a href=\"https://zafiramatchagency.com/privacidad-es/\" style=\"color:var(--gold);text-decoration:underline\" target=\"_blank\">Política de Privacidad</a>. Sé que puedo conocer, actualizar, rectificar y suprimir mis datos y revocar esta autorización escribiendo a business@zafiramatchagency.com.</span>\r\n            </label>\r\n            \r\n            <label class=\"check-group\" id=\"chkVerification\">\r\n              <input type=\"checkbox\" id=\"acceptVerification\">\r\n              <span data-es=\"Autorizo la verificación de mis antecedentes civiles, penales y de identidad según lo establecido por Zafira.\" data-en=\"I authorize the verification of my civil, criminal, and identity records as established by Zafira.\">Autorizo la verificación de mis antecedentes civiles, penales y de identidad según lo establecido por Zafira.</span>\r\n            </label>\r\n            <label class=\"check-group\" id=\"chkContact\">\r\n              <input type=\"checkbox\" id=\"acceptContact\">\r\n              <span data-es=\"Autorizo que Zafira me contacte por WhatsApp o correo electrónico para la entrevista privada y el seguimiento de mi registro.\" data-en=\"I authorise Zafira to contact me by WhatsApp or email for the private interview and follow-up of my registration.\">Autorizo que Zafira me contacte por WhatsApp o correo electrónico para la entrevista privada y el seguimiento de mi registro.</span>\r\n            </label>\r\n            <label class=\"check-group\" id=\"chkAdult\">\r\n              <input type=\"checkbox\" id=\"acceptAdult\">\r\n              <span data-es=\"Declaro que soy mayor de edad.\" data-en=\"I declare that I am of legal age.\">Declaro que soy mayor de edad.</span>\r\n            </label>\r\n          </div>\r\n          <div class=\"info-callout\" style=\"margin-top:20px\">\r\n            <p class=\"text-body\" style=\"font-size:.82rem\" data-es-html=\"<strong style='color:var(--gold)'>Importante:</strong> Zafira nunca te pedirá dinero. Tu participación es voluntaria y completamente gratuita, ahora y después.\" data-en-html=\"<strong style='color:var(--gold)'>Important:</strong> Zafira will never ask you for money. Your participation is voluntary and completely free, now and later.\">\r\n              <strong style=\"color:var(--gold)\">Importante:</strong> Zafira nunca te pedirá dinero. Tu participación es voluntaria y completamente gratuita, ahora y después.\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <p id=\"sendErr\" style=\"display:none;color:#e57373;font-size:.85rem;margin-top:16px\"></p>\r\n\r\n        <!-- Navigation -->\r\n        <div style=\"display:flex;justify-content:space-between;margin-top:32px\">\r\n          <button class=\"btn-outline\" id=\"backBtn\" onclick=\"goBack()\" style=\"display:none\" data-es=\"Atrás\" data-en=\"Back\">Atrás</button>\r\n          <div></div>\r\n          <button class=\"btn-gold\" id=\"nextBtn\" onclick=\"goNext()\" data-es=\"Continuar\" data-en=\"Continue\">Continuar</button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Success (hidden) -->\r\n      <div id=\"successMsg\" style=\"display:none;text-align:center;padding:80px 0;max-width:600px;margin:0 auto;\">\r\n        <div style=\"width:64px;height:64px;border:2px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px\">\r\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\r\n        </div>\r\n        <h2 class=\"heading-section\" data-es=\"Primer paso completado. Gracias por registrarte.\" data-en=\"First step completed. Thank you for registering.\">Primer paso completado. Gracias por registrarte.</h2>\r\n        <p class=\"text-body\" style=\"margin:16px auto 32px\" data-es=\"Tu asesora te enviará el formulario documental después de la entrevista. No tienes que hacer nada más por ahora: te contactamos por WhatsApp o por correo para agendar la videollamada.\" data-en=\"Your advisor will send you the document form after the interview. There is nothing else you need to do for now: we will contact you by WhatsApp or email to schedule the video call.\">Tu asesora te enviará el formulario documental después de la entrevista. No tienes que hacer nada más por ahora: te contactamos por WhatsApp o por correo para agendar la videollamada.</p>\r\n        \r\n        <p style=\"font-size:0.75rem;color:var(--gray);line-height:1.5;margin:0;\" data-es=\"Recuerda: Zafira nunca te pedirá dinero.\" data-en=\"Remember: Zafira will never ask you for money.\">Recuerda: Zafira nunca te pedirá dinero.</p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</main>\r\n\r\n<footer class=\"footer\"> \r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-href-en=\"https://zafiramatchagency.com/privacidad/\" data-href-es=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Privacy Policy\" data-es=\"Política de Privacidad\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/terminos/\" data-href-en=\"https://zafiramatchagency.com/terminos/\" data-href-es=\"https://zafiramatchagency.com/terminos-es/\" data-en=\"Terms &amp; Conditions\" data-es=\"Términos y Condiciones\">Terms &amp; Conditions</a>\r\n    <a href=\"https://zafiramatchagency.com/cancelaciones/\" data-href-en=\"https://zafiramatchagency.com/cancelaciones/\" data-href-es=\"https://zafiramatchagency.com/cancelaciones-es/\" data-en=\"Cancellations &amp; Refunds\" data-es=\"Cancelaciones y Reembolsos\">Cancellations &amp; Refunds</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <script>(function(){function u(l){document.querySelectorAll('a[data-href-'+l+']').forEach(function(a){a.href=a.getAttribute('data-href-'+l);});}var o=window.zafiraSetLang;window.zafiraSetLang=function(l){if(o)o(l);u(l);};function i(){u(window.zafiraGetLang?window.zafiraGetLang():'en');}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',i);}else{i();}})();</script>\r\n\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\"\r\n     data-en=\"Zafira is not a dating platform. We are a private matchmaking agency with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\"\r\n     \r\n     data-es=\"Zafira no es una plataforma de citas. Somos una agencia privada de matchmaking con procesos verificados. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">\r\n     \r\n     Zafira is not a dating platform. We are a private matchmaking agency with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\r\n  </p>\r\n</footer>\r\n\r\n<script>\r\nconst obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\n\r\n/* ── Config ── */\r\nvar API_URL='/wp-json/zafira/v1/solicitud';\r\n\r\n/* ── Steps ── */\r\nlet step=1;const total=4;\r\nlet blocked=false;\r\n\r\nfunction renderSteps(){\r\n  const bar=document.getElementById('stepBar');\r\n  bar.innerHTML='';\r\n  for(let i=1;i<=total;i++){\r\n    const cls=i===step?'dot active':i<step?'dot done':'dot';\r\n    bar.innerHTML+=`<div class=\"${cls}\">${i<step?'✓':i}</div>`;\r\n    if(i<total)bar.innerHTML+=`<div class=\"line${i<step?' done':''}\"></div>`;\r\n  }\r\n}\r\nrenderSteps();\r\n\r\nfunction showStep(n){\r\n  for(let i=1;i<=total;i++)document.getElementById('step'+i).style.display=i===n?'':'none';\r\n  document.getElementById('backBtn').style.display=n>1?'':'none';\r\n  var lang=window.zafiraGetLang?window.zafiraGetLang():'es';\r\n  if(n===total){\r\n    document.getElementById('nextBtn').textContent=lang==='es'?'Completar Mi Registro':'Complete My Registration';\r\n  }else{\r\n    document.getElementById('nextBtn').textContent=lang==='es'?'Continuar':'Continue';\r\n  }\r\n  renderSteps();\r\n}\r\n\r\nfunction checkMarried(v){\r\n  blocked=v==='Casada'||v==='Married';\r\n  document.getElementById('marriedBlock').style.display=blocked?'block':'none';\r\n}\r\n\r\nfunction goBack(){if(step>1){step--;showStep(step);}}\r\n\r\nfunction goNext(){\r\n  if(blocked)return;\r\n\r\n  if(step<total){\r\n    step++;\r\n    showStep(step);\r\n    return;\r\n  }\r\n\r\n  /* ── Paso 4: validar checkboxes ── */\r\n  var termsOk=document.getElementById('acceptTerms').checked;\r\n  var verifOk=document.getElementById('acceptVerification').checked;\r\n  var contactOk=document.getElementById('acceptContact').checked;\r\n  var adultOk=document.getElementById('acceptAdult').checked;\r\n  document.getElementById('chkContact').style.borderColor=contactOk?'':'rgba(239,68,68,.5)';\r\n  document.getElementById('chkAdult').style.borderColor=adultOk?'':'rgba(239,68,68,.5)';\r\n  document.getElementById('chkTerms').style.borderColor=termsOk?'':'rgba(239,68,68,.5)';\r\n  document.getElementById('chkVerification').style.borderColor=verifOk?'':'rgba(239,68,68,.5)';\r\n  if(!termsOk||!verifOk||!contactOk||!adultOk)return;\r\n\r\n  /* ── Recoger todos los datos ── */\r\n  var lang=window.zafiraGetLang?window.zafiraGetLang():'es';\r\n  var btn=document.getElementById('nextBtn');\r\n\r\n  /* Expectativas seleccionadas */\r\n  var expectations=[];\r\n  document.querySelectorAll('#step3 input[type=\"checkbox\"]:checked').forEach(function(cb){\r\n    expectations.push(cb.value);\r\n  });\r\n\r\n  var payload={\r\n    /* Paso 1 — Personal */\r\n    fullName:     (document.getElementById('fullName').value||'').trim(),\r\n    age:          (document.getElementById('age').value||'').trim(),\r\n    city:         (document.getElementById('city').value||'').trim(),\r\n    department:   (document.getElementById('department').value||'').trim(),\r\n    country:      (document.getElementById('country').value||'').trim(),\r\n    email:        (document.getElementById('email').value||'').trim(),\r\n    phone:        ((document.getElementById('phoneCode').value||'') + ' ' + (document.getElementById('phone').value||'')).trim(),\r\n    /* Paso 2 — Estado civil y profesión */\r\n    marital:      (document.getElementById('marital').value||'').trim(),\r\n    children:     (document.getElementById('children').value||'').trim(),\r\n    profession:   (document.getElementById('profession').value||'').trim(),\r\n    education:    (document.getElementById('education').value||'').trim(),\r\n    english:      (document.getElementById('english').value||'').trim(),\r\n    socialInsta:  (document.getElementById('socialInsta')?document.getElementById('socialInsta').value:'').trim(),\r\n    socialLinked: (document.getElementById('socialLinked')?document.getElementById('socialLinked').value:'').trim(),\r\n    socialFb:     (document.getElementById('socialFb')?document.getElementById('socialFb').value:'').trim(),\r\n    socialX:      (document.getElementById('socialX')?document.getElementById('socialX').value:'').trim(),\r\n    socialTiktok: (document.getElementById('socialTiktok')?document.getElementById('socialTiktok').value:'').trim(),\r\n    /* Paso 3 — Expectativas */\r\n    expectations: expectations.join(', '),\r\n    ageMin:       (document.getElementById('ageMin').value||'').trim(),\r\n    ageMax:       (document.getElementById('ageMax').value||'').trim(),\r\n    about:        (document.getElementById('about').value||'').trim(),\r\n    /* Meta */\r\n    formType:     'candidate',\r\n    consentData:  'Autoriza tratamiento de datos (Ley 1581)',\r\n    consentVerification: 'Autoriza verificación de antecedentes',\r\n    consentContact: 'Autoriza contacto por WhatsApp/correo',\r\n    adult:        'Declara ser mayor de edad',\r\n    lang:         lang,\r\n    source:       window.location.href,\r\n    timestamp:    new Date().toISOString()\r\n  };\r\n\r\n  /* ── Enviar a WordPress (Solicitudes + correo a business@) ── */\r\n  btn.textContent=lang==='es'?'Procesando...':'Processing...';\r\n  btn.disabled=true;\r\n\r\n  fetch(API_URL,{\r\n    method:'POST',\r\n    headers:{'Content-Type':'application/json'},\r\n    body:JSON.stringify(payload)\r\n  }).then(function(r){\r\n    if(!r.ok) throw new Error('HTTP '+r.status);\r\n    return r.text();\r\n  }).then(function(){\r\n    document.getElementById('formWrap').style.display='none';\r\n    document.getElementById('stepBar').style.display='none';\r\n    document.getElementById('successMsg').style.display='block';\r\n  }).catch(function(err){\r\n    console.warn('Envio error:',err);\r\n    var e=document.getElementById('sendErr'); e.textContent=(lang==='es')?'No pudimos enviar tu registro. Inténtalo de nuevo o escríbenos por WhatsApp al +1 360 227 7352.':'We could not send your registration. Please try again or message us on WhatsApp at +1 360 227 7352.'; e.style.display='block';\r\n  }).finally(function(){\r\n    btn.disabled=false;\r\n  });\r\n}\r\n</script>\r\n</body>\r\n</html>\r\n"
     },
