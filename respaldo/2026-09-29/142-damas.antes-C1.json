      "html": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Para Damas | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Zafira conecta mujeres latinas verificadas con hombres americanos serios a través de un proceso seguro, acompañamiento real y un evento privado en Colombia.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'es';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n<!-- Navbar -->\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\">\r\n      <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA\r\n    </a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <div class=\"lang-switch\">\r\n        <button class=\"lang-btn\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n        <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n      </div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\">\r\n      <button class=\"lang-btn\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n      <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n    </div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\r\n\r\n  <!-- Hero -->\r\n  <section class=\"sec\" style=\"background:radial-gradient(ellipse at 50% 30%,rgba(201,168,76,.05) 0%,transparent 55%),var(--black);padding-top:100px;padding-bottom:100px\">\r\n    <div class=\"wrap text-center\">\r\n      <h1 class=\"heading-display fade\" data-es=\"Tu seguridad y tu decisión van primero\" data-en=\"Your safety and your choice come first\">Tu seguridad y tu decisión van primero</h1>\r\n    <p class=\"text-body fade d1\" style=\"max-width:600px;margin:0 auto 36px\" data-es=\"Zafira es una agencia privada de intermediación y consultoría matrimonial para mujeres en Colombia y hombres de Estados Unidos que buscan una relación seria con intención de matrimonio. Para ti es gratis, ahora y después, y tu perfil no es público. Los caballeros pasan por un proceso de verificación antes de cualquier presentación y antes de poder conocer tu perfil. Tú decides cada presentación, caso por caso, y una asesora te acompaña en cada paso.\" data-en=\"Zafira is a private introduction agency and matrimonial consultancy for women in Colombia and men in the United States who want a serious relationship with marriage in mind. It is free for you, now and later, and your profile is not public. Gentlemen go through a verification process before any introduction and before they can see your profile. You decide each introduction, case by case, and an advisor accompanies you at every step.\">Zafira es una agencia privada de intermediación y consultoría matrimonial para mujeres en Colombia y hombres de Estados Unidos que buscan una relación seria con intención de matrimonio. Para ti es gratis, ahora y después, y tu perfil no es público. Los caballeros pasan por un proceso de verificación antes de cualquier presentación y antes de poder conocer tu perfil. Tú decides cada presentación, caso por caso, y una asesora te acompaña en cada paso.</p>\r\n      <div class=\"fade d2\"><span class=\"pill pill-gold\" data-es=\"Verificación de los dos lados · Acompañamiento\" data-en=\"Verification on both sides · Personal guidance\">Verificación de los dos lados · Acompañamiento</span></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Qué es Zafira -->\r\n  <section class=\"sec\" style=\"background:var(--dark)\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section text-center fade\" data-es-html=\"¿Qué es <span class='text-gold'>Zafira</span>?\" data-en-html=\"What is <span class='text-gold'>Zafira</span>?\">¿Qué es <span class=\"text-gold\">Zafira</span>?</h2>\r\n      <p class=\"text-body text-center fade d1\" style=\"max-width:720px;margin:20px auto 32px\" data-es=\"Una agencia de intermediación con propósito matrimonial: Zafira Limited Edition S.A.S., con oficina en Bogotá. Los caballeros son hombres de Estados Unidos que contratan un servicio profesional de búsqueda y acompañamiento. Tú nunca pagas nada y no recibes dinero por participar. No es una app de citas ni un sitio de perfiles: no hay ninguna lista donde alguien te pueda ver.\" data-en=\"An introduction agency with a matrimonial purpose: Zafira Limited Edition S.A.S., with its office in Bogotá. Gentlemen are men in the United States who contract a professional search and guidance service. You never pay anything and you do not receive money for taking part. It is not a dating app or a profile site: there is no list where anyone can see you.\">Una agencia de intermediación con propósito matrimonial: Zafira Limited Edition S.A.S., con oficina en Bogotá. Los caballeros son hombres de Estados Unidos que contratan un servicio profesional de búsqueda y acompañamiento. Tú nunca pagas nada y no recibes dinero por participar. No es una app de citas ni un sitio de perfiles: no hay ninguna lista donde alguien te pueda ver.</p>\r\n      <div class=\"grid-3\">\r\n        <div class=\"card text-center fade d1\">\r\n          <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg></div>\r\n          <h3 style=\"font-family:var(--ff-d);margin-bottom:10px\" data-es=\"Verificación de los dos lados\" data-en=\"Verification on both sides\">Verificación de los dos lados</h3>\r\n          <p class=\"text-body\" data-es=\"Tu identidad, tus antecedentes y tu estado civil se verifican bajo la legislación colombiana. Los caballeros pasan por un proceso de verificación antes de cualquier presentación y antes de poder conocer tu perfil.\" data-en=\"Your identity, background and marital status are verified under Colombian law. Gentlemen go through a verification process before any introduction and before they can see your profile.\">Tu identidad, tus antecedentes y tu estado civil se verifican bajo la legislación colombiana. Los caballeros pasan por un proceso de verificación antes de cualquier presentación y antes de poder conocer tu perfil.</p>\r\n        </div>\r\n        <div class=\"card text-center fade d2\">\r\n          <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg></div>\r\n          <h3 style=\"font-family:var(--ff-d);margin-bottom:10px\" data-es=\"Tu perfil es privado\" data-en=\"Your profile is private\">Tu perfil es privado</h3>\r\n          <p class=\"text-body\" data-es=\"No aparece en ninguna página abierta ni en redes sociales. Solo puede conocerlo un caballero que ya pasó su verificación, y solo si tú aceptas esa presentación. Ningún dato tuyo se comparte con un caballero sin tu decisión.\" data-en=\"It does not appear on any open page or social network. Only a gentleman who has passed his verification can learn about it, and only if you accept that introduction. None of your details are shared with a gentleman without your decision.\">No aparece en ninguna página abierta ni en redes sociales. Solo puede conocerlo un caballero que ya pasó su verificación, y solo si tú aceptas esa presentación. Ningún dato tuyo se comparte con un caballero sin tu decisión.</p>\r\n        </div>\r\n        <div class=\"card text-center fade d3\">\r\n          <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg></div>\r\n          <h3 style=\"font-family:var(--ff-d);margin-bottom:10px\" data-es=\"Acompañamiento\" data-en=\"Guidance\">Acompañamiento</h3>\r\n          <p class=\"text-body\" data-es=\"Una asesora te guía en cada paso, desde la entrevista inicial. Si hay interés de las dos partes, el encuentro en persona lo organiza y lo acompaña el equipo de Zafira: nunca estarás sola.\" data-en=\"An advisor guides you at every step, from the first interview. If both sides are interested, the in-person meeting is organised and accompanied by the Zafira team: you will never be alone.\">Una asesora te guía en cada paso, desde la entrevista inicial. Si hay interés de las dos partes, el encuentro en persona lo organiza y lo acompaña el equipo de Zafira: nunca estarás sola.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Proceso para Damas (W29) -->\r\n  <section class=\"sec\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section text-center fade\" data-es=\"Tu proceso\" data-en=\"Your process\">Tu proceso</h2>\r\n      <p class=\"text-body text-center fade d1\" style=\"max-width:600px;margin:16px auto 0\" data-es=\"Gratis, privado y acompañado. Tú decides cada paso.\" data-en=\"Free, private and accompanied. You decide every step.\">Gratis, privado y acompañado. Tú decides cada paso.</p>\r\n      <div style=\"height:40px\"></div>\r\n      <div class=\"wrap-sm\">\r\n        <div class=\"fade d1\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">1</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Paso 1 · Registro en línea\" data-en=\"Step 1 · Online registration\">Paso 1 · Registro en línea</h4><p class=\"text-body\" data-es=\"Completa tu registro con tus datos básicos, tu estado civil y lo que buscas en una relación. Toma pocos minutos y es gratis. Tu documento de identidad te lo pide tu asesora después de la entrevista, y ella te indicará si hace falta algo más.\" data-en=\"Complete your registration with your basic details, your marital status and what you are looking for in a relationship. It takes a few minutes and it is free. Your advisor asks for your identity document after the interview and will tell you if anything else is needed.\">Completa tu registro con tus datos básicos, tu estado civil y lo que buscas en una relación. Toma pocos minutos y es gratis. Tu documento de identidad te lo pide tu asesora después de la entrevista, y ella te indicará si hace falta algo más.</p></div>\r\n        </div>\r\n        <div class=\"fade d2\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">2</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Paso 2 · Entrevista con tu asesora\" data-en=\"Step 2 · Interview with your advisor\">Paso 2 · Entrevista con tu asesora</h4><p class=\"text-body\" data-es=\"Por videollamada, para conocerte, confirmar tu identidad y entender lo que esperas de un matrimonio.\" data-en=\"By video call, to get to know you, confirm your identity and understand what you hope for in a marriage.\">Por videollamada, para conocerte, confirmar tu identidad y entender lo que esperas de un matrimonio.</p></div>\r\n        </div>\r\n        <div class=\"fade d3\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">3</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Paso 3 · Verificación\" data-en=\"Step 3 · Verification\">Paso 3 · Verificación</h4><p class=\"text-body\" data-es=\"Tu identidad, tus antecedentes y tu estado civil se verifican bajo la legislación colombiana. Si algo no se puede verificar, el proceso se detiene. Registrarte no significa que ya fuiste aceptada: la aprobación la decide el equipo después de la entrevista y la verificación.\" data-en=\"Your identity, background and marital status are verified under Colombian law. If something cannot be verified, the process stops. Registering does not mean you have been accepted: the team decides on approval after the interview and the verification.\">Tu identidad, tus antecedentes y tu estado civil se verifican bajo la legislación colombiana. Si algo no se puede verificar, el proceso se detiene. Registrarte no significa que ya fuiste aceptada: la aprobación la decide el equipo después de la entrevista y la verificación.</p></div>\r\n        </div>\r\n        <div class=\"fade d4\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">4</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Paso 4 · Tú decides cada presentación\" data-en=\"Step 4 · You decide each introduction\">Paso 4 · Tú decides cada presentación</h4><p class=\"text-body\" data-es=\"Tu perfil no se publica ni aparece en ninguna lista. Solo pueden conocerlo caballeros que ya pasaron su propia verificación, y solo si tú lo aceptas. Antes de cada presentación recibes información sobre el caballero y decides libremente, caso por caso, si la aceptas y si quieres compartir tus datos de contacto. Puedes decir que no cuantas veces quieras, sin dar explicaciones.\" data-en=\"Your profile is not published and does not appear on any list. Only gentlemen who have passed their own verification can learn about it, and only if you agree. Before each introduction you receive information about the gentleman and decide freely, case by case, whether to accept it and whether to share your contact details. You can say no as many times as you wish, without giving reasons.\">Tu perfil no se publica ni aparece en ninguna lista. Solo pueden conocerlo caballeros que ya pasaron su propia verificación, y solo si tú lo aceptas. Antes de cada presentación recibes información sobre el caballero y decides libremente, caso por caso, si la aceptas y si quieres compartir tus datos de contacto. Puedes decir que no cuantas veces quieras, sin dar explicaciones.</p></div>\r\n        </div>\r\n        <div class=\"fade d5\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">5</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Paso 5 · Encuentro en Colombia, acompañada\" data-en=\"Step 5 · Meeting in Colombia, accompanied\">Paso 5 · Encuentro en Colombia, acompañada</h4><p class=\"text-body\" data-es=\"Si hay interés de las dos partes, te invitamos a un encuentro privado organizado por Zafira, donde conoces en persona al caballero cuya presentación aceptaste. Nunca estarás sola: el equipo de Zafira organiza y acompaña cada encuentro presencial.\" data-en=\"If both sides are interested, we invite you to a private gathering organised by Zafira, where you meet in person the gentleman whose introduction you accepted. You will never be alone: the Zafira team organises and accompanies every in-person meeting.\">Si hay interés de las dos partes, te invitamos a un encuentro privado organizado por Zafira, donde conoces en persona al caballero cuya presentación aceptaste. Nunca estarás sola: el equipo de Zafira organiza y acompaña cada encuentro presencial.</p></div>\r\n        </div>\r\n        <p class=\"text-body fade\" style=\"color:var(--gold)\" data-es=\"Gratis siempre: Zafira nunca te pedirá dinero, ni ahora ni después, y ninguna candidata recibe dinero por participar. Puedes retirarte cuando quieras.\" data-en=\"Free, always: Zafira will never ask you for money, now or later, and no candidate receives money for taking part. You can withdraw whenever you wish.\">Gratis siempre: Zafira nunca te pedirá dinero, ni ahora ni después, y ninguna candidata recibe dinero por participar. Puedes retirarte cuando quieras.</p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Lo que te prometemos (W07) -->\r\n  <section class=\"sec\" style=\"background:var(--dark)\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section text-center fade\" data-es=\"Lo que te prometemos\" data-en=\"What we promise you\">Lo que te prometemos</h2>\r\n      <div class=\"wrap-sm\" style=\"margin-top:24px\">\r\n        <p class=\"text-body fade d1\" style=\"margin-bottom:20px\" data-es=\"No publicamos historias ni resultados: cada proceso es distinto y preferimos no prometer lo que nadie puede asegurar. Lo que sí te prometemos es cómo te vamos a tratar:\" data-en=\"We do not publish stories or results: every process is different, and we would rather not promise what no one can ensure. What we do promise is how you will be treated:\">No publicamos historias ni resultados: cada proceso es distinto y preferimos no prometer lo que nadie puede asegurar. Lo que sí te prometemos es cómo te vamos a tratar:</p>\r\n        <ul class=\"fade d2\" style=\"list-style:none;margin:0 0 20px 0\">\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Nunca te pediremos dinero.</strong> Tu registro es gratuito, ahora y después.\" data-en-html=\"<strong style='color:var(--gold)'>We will never ask you for money.</strong> Registration is free, now and later.\"><strong style='color:var(--gold)'>Nunca te pediremos dinero.</strong> Tu registro es gratuito, ahora y después.</li>\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Tu perfil no será público.</strong> No aparece en ninguna página abierta ni en redes sociales.\" data-en-html=\"<strong style='color:var(--gold)'>Your profile will not be public.</strong> It does not appear on any open page or social network.\"><strong style='color:var(--gold)'>Tu perfil no será público.</strong> No aparece en ninguna página abierta ni en redes sociales.</li>\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Los caballeros se verifican antes.</strong> Pasan por un proceso de verificación antes de cualquier presentación y antes de poder conocer tu perfil.\" data-en-html=\"<strong style='color:var(--gold)'>Gentlemen are verified first.</strong> They go through a verification process before any introduction and before they can see your profile.\"><strong style='color:var(--gold)'>Los caballeros se verifican antes.</strong> Pasan por un proceso de verificación antes de cualquier presentación y antes de poder conocer tu perfil.</li>\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Tú decides cada presentación.</strong> Recibes información sobre el caballero antes de decidir, y puedes decir que no cuantas veces quieras.\" data-en-html=\"<strong style='color:var(--gold)'>You decide each introduction.</strong> You receive information about the gentleman before deciding, and you can say no as many times as you wish.\"><strong style='color:var(--gold)'>Tú decides cada presentación.</strong> Recibes información sobre el caballero antes de decidir, y puedes decir que no cuantas veces quieras.</li>\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Ningún dato tuyo se comparte con un caballero sin tu decisión.</strong> Ni tu teléfono, ni tus redes, ni tus fotos.\" data-en-html=\"<strong style='color:var(--gold)'>None of your details are shared with a gentleman without your decision.</strong> Not your phone number, your social media or your photos.\"><strong style='color:var(--gold)'>Ningún dato tuyo se comparte con un caballero sin tu decisión.</strong> Ni tu teléfono, ni tus redes, ni tus fotos.</li>\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Nunca estarás sola.</strong> Una asesora te guía en cada paso y el equipo de Zafira acompaña cada encuentro presencial.\" data-en-html=\"<strong style='color:var(--gold)'>You will never be alone.</strong> An advisor guides you at every step, and the Zafira team accompanies every in-person meeting.\"><strong style='color:var(--gold)'>Nunca estarás sola.</strong> Una asesora te guía en cada paso y el equipo de Zafira acompaña cada encuentro presencial.</li>\r\n          <li class=\"text-body\" style=\"margin-bottom:12px\" data-es-html=\"<strong style='color:var(--gold)'>Puedes irte cuando quieras.</strong> Te retiras sin dar explicaciones y puedes pedir que borremos tus datos, salvo lo que la ley nos obligue a conservar.\" data-en-html=\"<strong style='color:var(--gold)'>You can leave whenever you want.</strong> You can withdraw without giving reasons and ask us to delete your data, except what the law requires us to keep.\"><strong style='color:var(--gold)'>Puedes irte cuando quieras.</strong> Te retiras sin dar explicaciones y puedes pedir que borremos tus datos, salvo lo que la ley nos obligue a conservar.</li>\r\n        </ul>\r\n        <p class=\"text-body fade d3\" style=\"margin-bottom:28px\" data-es=\"Lo que no te prometemos: un resultado. Nadie puede prometer que una presentación termine en una relación o en un matrimonio.\" data-en=\"What we do not promise you: an outcome. No one can promise that an introduction will lead to a relationship or a marriage.\">Lo que no te prometemos: un resultado. Nadie puede prometer que una presentación termine en una relación o en un matrimonio.</p>\r\n        <div class=\"fade d3 text-center\"><a class=\"btn-gold\" data-es=\"Iniciar mi registro\" data-en=\"Start my registration\" href=\"https://zafiramatchagency.com/registro-candidata/\">Iniciar mi registro</a></div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <script>\r\n    (function(){\r\n      const carousel=document.getElementById('testimonialCarousel');\r\n      if(carousel){\r\n      const track=carousel.querySelector('.carousel-track'),\r\n      slides=carousel.querySelectorAll('.carousel-slide'),\r\n      prevBtn=document.getElementById('carouselPrev'),\r\n      nextBtn=document.getElementById('carouselNext'),\r\n      dotsC=document.getElementById('carouselDots'),\r\n      dots=dotsC?dotsC.querySelectorAll('.carousel-dot'):[],\r\n      total=slides.length;\r\n      let cur=0,autoI=null,tsx=0,tex=0;\r\n\r\n      function go(i){if(i<0)i=total-1;if(i>=total)i=0;cur=i;\r\n      track.style.transform='translateX(-'+cur*100+'%)';\r\n      dots.forEach((d,j)=>{d.classList.toggle('active',j===cur);d.setAttribute('aria-selected',j===cur?'true':'false');});\r\n      slides.forEach((s,j)=>s.setAttribute('aria-hidden',j!==cur?'true':'false'));\r\n      }\r\n      function startAP(){stopAP();autoI=setInterval(()=>go(cur+1),5000);}\r\n      function stopAP(){if(autoI){clearInterval(autoI);autoI=null;}}\r\n\r\n      if(prevBtn)prevBtn.addEventListener('click',()=>{go(cur-1);stopAP();startAP();});\r\n      if(nextBtn)nextBtn.addEventListener('click',()=>{go(cur+1);stopAP();startAP();});\r\n      dots.forEach((d,i)=>d.addEventListener('click',()=>{go(i);stopAP();startAP();}));\r\n      carousel.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();go(cur-1);stopAP();startAP();}\r\n      else if(e.key==='ArrowRight'){e.preventDefault();go(cur+1);stopAP();startAP();}});\r\n      carousel.addEventListener('mouseenter',stopAP);carousel.addEventListener('mouseleave',startAP);\r\n      carousel.addEventListener('focusin',stopAP);carousel.addEventListener('focusout',startAP);\r\n      carousel.addEventListener('touchstart',e=>{tsx=e.changedTouches[0].screenX;},{passive:true});\r\n      carousel.addEventListener('touchend',e=>{tex=e.changedTouches[0].screenX;const d=tsx-tex;\r\n      if(Math.abs(d)>50){go(d>0?cur+1:cur-1);stopAP();startAP();}},{passive:true});\r\n      go(0);startAP();\r\n      }\r\n    })();\r\n  </script>\r\n\r\n  <!-- Seguridad -->\r\n  <section class=\"sec\" style=\"background:var(--dark)\">\r\n    <div class=\"wrap text-center\">\r\n      <h2 class=\"heading-section fade\" data-es-html=\"Tu Seguridad es <span class='text-gold'>Prioridad</span>\" data-en-html=\"Your Safety is Our <span class='text-gold'>Priority</span>\">Tu Seguridad es <span class=\"text-gold\">Prioridad</span></h2>\r\n      <div style=\"height:24px\"></div>\r\n      <div class=\"wrap-sm text-center\">\r\n        <div class=\"info-callout fade d1\" style=\"text-align:left;margin-bottom:16px\">\r\n          <p class=\"text-body\" data-es=\"Zafira nunca te pedirá dinero. Tu participación es voluntaria y gratuita, ahora y después.\" data-en=\"Zafira will never ask you for money. Your participation is voluntary and free, now and later.\">Zafira nunca te pedirá dinero. Tu participación es voluntaria y gratuita, ahora y después.</p>\r\n        </div>\r\n        <div class=\"info-callout fade d2\" style=\"text-align:left;margin-bottom:16px\">\r\n          <p class=\"text-body\" data-es=\"Tu perfil no es público. Solo caballeros verificados y aprobados pueden acceder a tu información, y solo si tú aceptas la presentación.\" data-en=\"Your profile is not public. Only verified and approved gentlemen may access your information, and only if you accept the introduction.\">Tu perfil no es público. Solo caballeros verificados y aprobados pueden acceder a tu información, y solo si tú aceptas la presentación.</p>\r\n        </div>\r\n        <div class=\"info-callout fade d3\" style=\"text-align:left\">\r\n          <p class=\"text-body\" data-es=\"Cada encuentro presencial es organizado y acompañado por el equipo de Zafira. Nunca estarás sola.\" data-en=\"Every in-person meeting is organized and accompanied by the Zafira team. You will never be alone.\">Cada encuentro presencial es organizado y acompañado por el equipo de Zafira. Nunca estarás sola.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CTA -->\r\n  <section class=\"sec text-center\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section fade\" data-es-html=\"¿Lista para <span class='text-gold'>Comenzar</span>?\" data-en-html=\"Ready to <span class='text-gold'>Begin</span>?\">¿Lista para <span class=\"text-gold\">Comenzar</span>?</h2>\r\n      <p class=\"text-body fade d1\" style=\"margin-bottom:32px;max-width:460px;margin-left:auto;margin-right:auto\" data-es=\"Completa tu registro para iniciar el proceso de verificación y acompañamiento.\" data-en=\"Complete your registration to begin the verification and accompaniment process.\">Completa tu registro para iniciar el proceso de verificación y acompañamiento.</p>\r\n      <a href=\"https://zafiramatchagency.com/registro-candidata/\" class=\"btn-gold fade d2\" data-es=\"Iniciar Mi Registro →\" data-en=\"Start My Registration →\">Iniciar Mi Registro →</a>\r\n    </div>\r\n  </section>\r\n\r\n</main>\r\n\r\n<footer class=\"footer\"> \r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-href-en=\"https://zafiramatchagency.com/privacidad/\" data-href-es=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Privacy Policy\" data-es=\"Política de Privacidad\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/terminos/\" data-href-en=\"https://zafiramatchagency.com/terminos/\" data-href-es=\"https://zafiramatchagency.com/terminos-es/\" data-en=\"Terms &amp; Conditions\" data-es=\"Términos y Condiciones\">Terms &amp; Conditions</a>\r\n    <a href=\"https://zafiramatchagency.com/cancelaciones/\" data-href-en=\"https://zafiramatchagency.com/cancelaciones/\" data-href-es=\"https://zafiramatchagency.com/cancelaciones-es/\" data-en=\"Cancellations &amp; Refunds\" data-es=\"Cancelaciones y Reembolsos\">Cancellations &amp; Refunds</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <script>(function(){function u(l){document.querySelectorAll('a[data-href-'+l+']').forEach(function(a){a.href=a.getAttribute('data-href-'+l);});}var o=window.zafiraSetLang;window.zafiraSetLang=function(l){if(o)o(l);u(l);};function i(){u(window.zafiraGetLang?window.zafiraGetLang():'en');}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',i);}else{i();}})();</script>\r\n\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\"\r\n     data-en=\"Zafira is not a dating platform. We are a private matchmaking agency with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\"\r\n     \r\n     data-es=\"Zafira no es una plataforma de citas. Somos una agencia privada de matchmaking con procesos verificados. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">\r\n     \r\n     Zafira is not a dating platform. We are a private matchmaking agency with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\r\n  </p>\r\n</footer>\r\n\r\n<script>\r\nconst obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\n</script>\r\n</body>\r\n</html>\r\n"
