    "settings": {
     "html": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Para Damas | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Zafira conecta mujeres latinas verificadas con hombres americanos serios a través de un proceso seguro, acompañamiento real y un evento privado en Colombia.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'es';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n<!-- Navbar -->\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\">\r\n      <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA\r\n    </a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <div class=\"lang-switch\">\r\n        <button class=\"lang-btn\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n        <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n      </div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\">\r\n      <button class=\"lang-btn\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n      <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n    </div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\r\n\r\n  <!-- Hero -->\r\n  <section class=\"sec\" style=\"background:radial-gradient(ellipse at 50% 30%,rgba(201,168,76,.05) 0%,transparent 55%),var(--black);padding-top:100px;padding-bottom:100px\">\r\n    <div class=\"wrap text-center\">\r\n      <h1 class=\"heading-display fade\" data-es-html=\"Tu Futuro Comienza con <span class='text-gold'>Confianza</span>\" data-en-html=\"Your Future Begins with <span class='text-gold'>Confidence</span>\">Tu Futuro Comienza con <span class=\"text-gold\">Confianza</span></h1>\r\n    <p class=\"text-body fade d1\" style=\"max-width:600px;margin:0 auto 36px\" data-es=\"Zafira crea experiencias exclusivas de event matching para mujeres latinoamericanas verificadas y hombres americanos intencionales. Sin apps. Sin algoritmos. Solo conexiones reales, perfiles verificados y acompañamiento auténtico.\"data-en=\"Zafira creates exclusive event matching experiences for verified Latin American women and intentional American men. No apps. No algorithms. Just real connections, verified profiles, and authentic guidance throughout every stage.\"> Zafira crea experiencias exclusivas de event matching para mujeres latinoamericanas verificadas y hombres americanos intencionales. Sin apps. Sin algoritmos. Solo conexiones reales, perfiles verificados y acompañamiento auténtico.</p>\r\n      <div class=\"fade d2\"><span class=\"pill pill-gold\" data-es=\"Verificación · Acompañamiento\" data-en=\"Verification · Accompaniment\">Verificación · Acompañamiento</span></div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Qué es Zafira -->\r\n  <section class=\"sec\" style=\"background:var(--dark)\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section text-center fade\" data-es-html=\"¿Qué es <span class='text-gold'>Zafira</span>?\" data-en-html=\"What is <span class='text-gold'>Zafira</span>?\">¿Qué es <span class=\"text-gold\">Zafira</span>?</h2>\r\n      <div style=\"height:32px\"></div>\r\n      <div class=\"grid-3\">\r\n        <div class=\"card text-center fade d1\">\r\n          <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg></div>\r\n          <h3 style=\"font-family:var(--ff-d);margin-bottom:10px\" data-es=\"Verificación Real\" data-en=\"Real Verification\">Verificación Real</h3>\r\n          <p class=\"text-body\" data-es=\"Cada candidato pasa por verificación de antecedentes civiles, penales y de identidad antes de poder ver tu perfil.\" data-en=\"Every male candidate undergoes full civil, criminal, and identity verification before gaining access to your profile.\">Cada candidato pasa por verificación de antecedentes civiles, penales y de identidad antes de poder ver tu perfil.</p>\r\n        </div>\r\n        <div class=\"card text-center fade d2\">\r\n          <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg></div>\r\n          <h3 style=\"font-family:var(--ff-d);margin-bottom:10px\" data-es=\"Seguridad Primero\" data-en=\"Safety First\">Seguridad Primero</h3>\r\n          <p class=\"text-body\" data-es=\"Tu información es privada. Tus fotos y datos nunca se comparten públicamente. Solo candidatos verificados acceden a tu perfil.\" data-en=\"Your information remains private. Your photos and personal data are never shared publicly. Only verified candidates may access your profile.\">Tu información es privada. Tus fotos y datos nunca se comparten públicamente. Solo candidatos verificados acceden a tu perfil.</p>\r\n        </div>\r\n        <div class=\"card text-center fade d3\">\r\n          <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg></div>\r\n          <h3 style=\"font-family:var(--ff-d);margin-bottom:10px\" data-es=\"Acompañamiento\" data-en=\"Full Accompaniment\">Acompañamiento</h3>\r\n          <p class=\"text-body\" data-es=\"Una asesora te guía en cada paso, desde la entrevista inicial hasta el evento privado en Colombia donde conocerás a tu candidato.\" data-en=\"A dedicated female advisor guides you at every stage — from your initial interview to the private event in Colombia where you will meet your matched candidate.\">Una asesora te guía en cada paso, desde la entrevista inicial hasta el evento privado en Colombia donde conocerás a tu candidato.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Proceso para Damas -->\r\n  <section class=\"sec\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section text-center fade\" data-es-html=\"Tu <span class='text-gold'>Proceso</span>\" data-en-html=\"Your <span class='text-gold'>Process</span>\">Tu <span class=\"text-gold\">Proceso</span></h2>\r\n      <div style=\"height:40px\"></div>\r\n      <div class=\"wrap-sm\">\r\n        <div class=\"fade d1\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">1</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Registro en Línea\" data-en=\"Online Registration\">Registro en Línea</h4><p class=\"text-body\" data-es=\"Completa tu registro con tu información personal. Es gratuito y voluntario.\" data-en=\"Complete your registration with your personal information. It is free and voluntary.\">Completa tu registro con tu información personal. Es gratuito y voluntario.</p></div>\r\n        </div>\r\n        <div class=\"fade d2\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">2</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Entrevista con Asesora\" data-en=\"Advisor Interview\">Entrevista con Asesora</h4><p class=\"text-body\" data-es=\"Una asesora de Zafira te contactará por videollamada para conocerte, verificar tu identidad y entender tus expectativas matrimoniales.\" data-en=\"A Zafira advisor will contact you via video call to get to know you, verify your identity, and understand your expectations for marriage.\">Una asesora de Zafira te contactará por videollamada para conocerte, verificar tu identidad y entender tus expectativas matrimoniales.</p></div>\r\n        </div>\r\n        <div class=\"fade d3\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">3</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Verificación de Antecedentes\" data-en=\"Background Verification\">Verificación de Antecedentes</h4><p class=\"text-body\" data-es=\"Tu estado civil, antecedentes y documentos son verificados bajo legislación colombiana vigente.\" data-en=\"Your civil status, background, and documentation are verified under current Colombian legislation.\">Tu estado civil, antecedentes y documentos son verificados bajo legislación colombiana vigente.</p></div>\r\n        </div>\r\n        <div class=\"fade d4\" style=\"display:flex;gap:20px;align-items:flex-start;margin-bottom:32px\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">4</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Presentación de Perfil\" data-en=\"Profile Presentation\">Presentación de Perfil</h4><p class=\"text-body\" data-es=\"Tu perfil es presentado a candidatos compatibles ya verificados que buscan una relación matrimonial seria.\" data-en=\"Your profile is presented to compatible, pre-verified candidates who are actively seeking a serious matrimonial relationship.\">Tu perfil es presentado a candidatos compatibles ya verificados que buscan una relación matrimonial seria.</p></div>\r\n        </div>\r\n        <div class=\"fade d5\" style=\"display:flex;gap:20px;align-items:flex-start\">\r\n          <div class=\"tl-num\" style=\"flex-shrink:0;background:var(--black)\">5</div>\r\n          <div><h4 style=\"font-family:var(--ff-d);margin-bottom:6px\" data-es=\"Evento Zafira en Colombia\" data-en=\"The Zafira Event in Colombia\">Evento Zafira en Colombia</h4><p class=\"text-body\" data-es=\"Si hay interés mutuo, serás invitada a un evento privado organizado por Zafira donde conocerás a tu candidato en persona, con acompañamiento total.\" data-en=\"If there is mutual interest, you will be invited to a private event organized by Zafira where you will meet your candidate in person, with full accompaniment.\">Si hay interés mutuo, serás invitada a un evento privado organizado por Zafira donde conocerás a tu candidato en persona, con acompañamiento total.</p></div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  \r\n\r\n  <script>\r\n    (function(){\r\n      const carousel=document.getElementById('testimonialCarousel');\r\n      if(carousel){\r\n      const track=carousel.querySelector('.carousel-track'),\r\n      slides=carousel.querySelectorAll('.carousel-slide'),\r\n      prevBtn=document.getElementById('carouselPrev'),\r\n      nextBtn=document.getElementById('carouselNext'),\r\n      dotsC=document.getElementById('carouselDots'),\r\n      dots=dotsC?dotsC.querySelectorAll('.carousel-dot'):[],\r\n      total=slides.length;\r\n      let cur=0,autoI=null,tsx=0,tex=0;\r\n\r\n      function go(i){if(i<0)i=total-1;if(i>=total)i=0;cur=i;\r\n      track.style.transform='translateX(-'+cur*100+'%)';\r\n      dots.forEach((d,j)=>{d.classList.toggle('active',j===cur);d.setAttribute('aria-selected',j===cur?'true':'false');});\r\n      slides.forEach((s,j)=>s.setAttribute('aria-hidden',j!==cur?'true':'false'));\r\n      }\r\n      function startAP(){stopAP();autoI=setInterval(()=>go(cur+1),5000);}\r\n      function stopAP(){if(autoI){clearInterval(autoI);autoI=null;}}\r\n\r\n      if(prevBtn)prevBtn.addEventListener('click',()=>{go(cur-1);stopAP();startAP();});\r\n      if(nextBtn)nextBtn.addEventListener('click',()=>{go(cur+1);stopAP();startAP();});\r\n      dots.forEach((d,i)=>d.addEventListener('click',()=>{go(i);stopAP();startAP();}));\r\n      carousel.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();go(cur-1);stopAP();startAP();}\r\n      else if(e.key==='ArrowRight'){e.preventDefault();go(cur+1);stopAP();startAP();}});\r\n      carousel.addEventListener('mouseenter',stopAP);carousel.addEventListener('mouseleave',startAP);\r\n      carousel.addEventListener('focusin',stopAP);carousel.addEventListener('focusout',startAP);\r\n      carousel.addEventListener('touchstart',e=>{tsx=e.changedTouches[0].screenX;},{passive:true});\r\n      carousel.addEventListener('touchend',e=>{tex=e.changedTouches[0].screenX;const d=tsx-tex;\r\n      if(Math.abs(d)>50){go(d>0?cur+1:cur-1);stopAP();startAP();}},{passive:true});\r\n      go(0);startAP();\r\n      }\r\n    })();\r\n  </script>\r\n\r\n  <!-- Seguridad -->\r\n  <section class=\"sec\" style=\"background:var(--dark)\">\r\n    <div class=\"wrap text-center\">\r\n      <h2 class=\"heading-section fade\" data-es-html=\"Tu Seguridad es <span class='text-gold'>Prioridad</span>\" data-en-html=\"Your Safety is Our <span class='text-gold'>Priority</span>\">Tu Seguridad es <span class=\"text-gold\">Prioridad</span></h2>\r\n      <div style=\"height:24px\"></div>\r\n      <div class=\"wrap-sm text-center\">\r\n        <div class=\"info-callout fade d1\" style=\"text-align:left;margin-bottom:16px\">\r\n          <p class=\"text-body\" data-es=\"Zafira nunca te pedirá dinero. Todos los costos son asumidos por el candidato masculino.\" data-en=\"Zafira will never ask you for money. All costs are covered by the male candidate.\">Zafira nunca te pedirá dinero. Todos los costos son asumidos por el candidato masculino.</p>\r\n        </div>\r\n        <div class=\"info-callout fade d2\" style=\"text-align:left;margin-bottom:16px\">\r\n          <p class=\"text-body\" data-es=\"Tu perfil no es público. Solo candidatos verificados y aprobados pueden acceder a tu información.\" data-en=\"Your profile is not public. Only verified and approved candidates may access your information.\">Tu perfil no es público. Solo candidatos verificados y aprobados pueden acceder a tu información.</p>\r\n        </div>\r\n        <div class=\"info-callout fade d3\" style=\"text-align:left\">\r\n          <p class=\"text-body\" data-es=\"Cada encuentro presencial es organizado y acompañado por el equipo de Zafira. Nunca estarás sola.\" data-en=\"Every in-person meeting is organized and accompanied by the Zafira team. You will never be alone.\">Cada encuentro presencial es organizado y acompañado por el equipo de Zafira. Nunca estarás sola.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CTA -->\r\n  <section class=\"sec text-center\">\r\n    <div class=\"wrap\">\r\n      <h2 class=\"heading-section fade\" data-es-html=\"¿Lista para <span class='text-gold'>Comenzar</span>?\" data-en-html=\"Ready to <span class='text-gold'>Begin</span>?\">¿Lista para <span class=\"text-gold\">Comenzar</span>?</h2>\r\n      <p class=\"text-body fade d1\" style=\"margin-bottom:32px;max-width:460px;margin-left:auto;margin-right:auto\" data-es=\"Completa tu registro para iniciar el proceso de verificación y acompañamiento.\" data-en=\"Complete your registration to begin the verification and accompaniment process.\">Completa tu registro para iniciar el proceso de verificación y acompañamiento.</p>\r\n      <a href=\"https://zafiramatchagency.com/registro-candidata/\" class=\"btn-gold fade d2\" data-es=\"Iniciar Mi Registro →\" data-en=\"Start My Registration →\">Iniciar Mi Registro →</a>\r\n    </div>\r\n  </section>\r\n\r\n</main>\r\n\r\n<footer class=\"footer\"> \r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-en=\"Privacy Policy\" data-es=\"Política de privacidad\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\"\r\n     data-en=\"Zafira is not a dating platform. We create exclusive matching experiences through private events, verified profiles, and intentional connections. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\"\r\n     \r\n     data-es=\"Zafira no es una plataforma de citas. Creamos experiencias exclusivas de matching mediante eventos privados, perfiles verificados y conexiones intencionales. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">\r\n     \r\n     Zafira is not a dating platform. We create exclusive matching experiences through private events, verified profiles, and intentional connections. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\r\n  </p>\r\n</footer>\r\n\r\n<script>\r\nconst obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\n</script>\r\n</body>\r\n</html>\r\n"
    },
