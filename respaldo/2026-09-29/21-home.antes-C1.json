     "settings": {
      "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>ZAFIRA — Where Verification Meets Matrimony</title>\r\n<meta name=\"description\" content=\"ZAFIRA curated introductions, and a private Colombia event. Not a dating app.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"css/styles.css\">\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'en';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n<style>\r\n/* ── Hero specifics ── */\r\n#hero{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}\r\n.hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(ellipse at 50% 25%,rgba(201,168,76,.07) 0%,transparent 55%),radial-gradient(ellipse at 80% 75%,rgba(10,10,26,.95) 0%,var(--black) 100%)}\r\n.hero-bg::after{content:'';position:absolute;inset:0;opacity:.035;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");background-size:128px}\r\n.hero-in{position:relative;z-index:2;padding:0 24px;max-width:700px}\r\n.hero-logo{font-family:var(--ff-d);font-size:clamp(3.4rem,8vw,5.8rem);font-weight:700;letter-spacing:.24em;color:var(--gold);text-shadow:0 0 70px rgba(201,168,76,.22);margin-bottom:10px}\r\n.hero-tag{font-family:var(--ff-d);font-size:clamp(1rem,2.4vw,1.3rem);font-weight:400;color:var(--gray);letter-spacing:.04em;margin-bottom:50px;font-style:italic}\r\n.hero-btns{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin-bottom:60px}\r\n.hero-counter{display:flex;align-items:baseline;gap:10px;justify-content:center;margin-bottom:22px}\r\n.counter-n{font-family:var(--ff-d);font-size:clamp(2.4rem,5vw,3.2rem);font-weight:700;background:linear-gradient(135deg,var(--gold),#e8d48b,var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}\r\n.counter-l{font-size:.82rem;color:var(--gray);letter-spacing:.08em;text-transform:uppercase}\r\n/* Event glow */\r\n.ev-glow{position:absolute;top:50%;left:50%;width:600px;height:600px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(201,168,76,.06) 0%,transparent 70%);pointer-events:none}\r\n/* Process Steps */\r\n.process-step{background:#1a1a24;border:1px solid rgba(201,168,76,.1);border-radius:16px;padding:36px;margin-bottom:32px;position:relative;transition:transform .4s cubic-bezier(0.16, 1, 0.3, 1),border-color .4s;text-align:left}\r\n.process-step:hover{transform:translateY(-6px);border-color:rgba(201,168,76,.4)}\r\n.process-num{position:absolute;top:-16px;left:36px;background:var(--black);border:1px solid rgba(201,168,76,.4);color:var(--gold);font-family:var(--ff-d);font-size:1rem;font-weight:600;padding:6px 16px;border-radius:20px;letter-spacing:.05em}\r\n.process-title{font-family:var(--ff-d);font-size:1.5rem;color:var(--white);margin-bottom:14px;margin-top:12px;font-weight:500}\r\n.process-price{font-family:var(--ff-d);font-size:2rem;color:var(--gold);font-weight:600;margin-top:20px;margin-bottom:8px}\r\n.process-line{position:absolute;left:58px;top:40px;bottom:-40px;width:1px;background:linear-gradient(to bottom,rgba(201,168,76,.4),rgba(201,168,76,0));z-index:-1}\r\n.process-step:last-child .process-line{display:none}\r\n@media(max-width:740px){.hero-btns{flex-direction:column;align-items:center}.btn-ghost{width:230px;justify-content:center}.process-step{padding:28px 24px}.process-num{left:24px}.process-line{left:46px}}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<!-- No navbar on landing (WF-02.F) -->\r\n\r\n<!-- Language Switcher (hero page — fixed position) -->\r\n<div class=\"lang-switch lang-switch-hero\">\r\n  <button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button>\r\n  <button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button>\r\n</div>\r\n\r\n<!-- ═══ 1. HERO ═══ -->\r\n<section id=\"hero\">\r\n  <style>\r\n    #hero { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; perspective: 1000px; }\r\n    .hero-bg { position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse at 50% 25%, rgba(201,168,76,.08) 0%, transparent 60%), radial-gradient(ellipse at 80% 75%, rgba(10,10,26,.98) 0%, var(--black) 100%); transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1); }\r\n    .hero-bg::after { content:''; position: absolute; inset: 0; opacity: .04; background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\"); background-size: 128px; mix-blend-mode: overlay; }\r\n    #heroCanvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; opacity: 0.8; }\r\n    .hero-in { position: relative; z-index: 2; padding: 0 24px; max-width: 700px; transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1); transform-style: preserve-3d; }\r\n    \r\n    /* Hover Immersion */\r\n    #hero:hover .hero-bg { transform: scale(1.03); }\r\n    #hero:hover .hero-in { transform: translateY(-8px) translateZ(10px); }\r\n    #hero:hover .hero-logo { text-shadow: 0 0 90px rgba(201,168,76,.35); transform: scale(1.01); }\r\n    \r\n    .hero-logo { transition: all 1s cubic-bezier(0.16, 1, 0.3, 1); font-family: var(--ff-d); font-size: clamp(3.4rem, 8vw, 5.8rem); font-weight: 700; letter-spacing: .24em; color: var(--gold); text-shadow: 0 0 70px rgba(201,168,76,.22); margin-bottom: 10px; }\r\n  </style>\r\n\r\n  <div class=\"hero-bg\" id=\"heroBg\">\r\n    <canvas id=\"heroCanvas\"></canvas>\r\n  </div>\r\n  \r\n  <div class=\"hero-in\">\r\n    <div class=\"fade\" style=\"margin-bottom:10px\">\r\n      <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"Zafira\" style=\"width:140px;height:auto;margin:0 auto 16px;mix-blend-mode:lighten;filter:drop-shadow(0 0 40px rgba(201,168,76,.3)); transition: transform 1s ease\">\r\n      <div class=\"hero-logo\">ZAFIRA</div>\r\n    </div>\r\n    <p class=\"hero-tag fade d1\" data-en=\"Exclusive Private Event\" data-es=\"Evento Privado Exclusivo\">Exclusive Private Event</p>\r\n    <h1 class=\"heading-display fade d2\" style=\"color:var(--white);margin-bottom:16px;font-size:24px;\" data-en-html=\"Some Doors Were Never Meant To Be Opened… <span class='text-gold'>Only To Choose Who Enters.</span>\" data-es-html=\"Algunas Puertas No Fueron Hechas Para Abrirse… <span class='text-gold'>Sino Para Elegir Quién Merece Entrar.</span>\">Some Doors Were Never Meant To Be Opened… <span class=\"text-gold\">Only To Choose Who Enters.</span></h1>\r\n    <p class=\"text-body text-center fade d3\" style=\"margin-bottom:36px;max-width:580px;margin-left:auto;margin-right:auto\" data-en=\"An invitation-only experience for authentic individuals seeking high-level connections. Elegance, absolute privacy, and curated encounters.\" data-es=\"Una experiencia solo por invitación para personas auténticas que buscan conexiones de alto nivel. Elegancia, privacidad absoluta y encuentros selectos.\">An invitation-only experience for authentic individuals seeking high-level connections. Elegance, absolute privacy, and curated encounters.</p>\r\n    <div class=\"hero-btns fade d4\">\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"btn-ghost\"><span data-en=\"Gentlemen →\" data-es=\"Caballeros →\">Gentlemen →</span></a>\r\n      <a href=\"https://zafiramatchagency.com/damas/\" class=\"btn-ghost\"><span data-en=\"Ladies →\" data-es=\"Damas →\">Ladies →</span></a>\r\n    </div>\r\n    <div class=\"fade d5\">\r\n      <span class=\"pill pill-gold\">\r\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\r\n        <span data-en=\"Invitation Only &nbsp;|&nbsp; Not a Dating App\" data-es=\"Solo por Invitación &nbsp;|&nbsp; No es una App de Citas\">Invitation Only &nbsp;|&nbsp; Not a Dating App</span>\r\n      </span>\r\n    </div>\r\n  </div>\r\n\r\n  <script>\r\n    (function(){\r\n      const canvas = document.getElementById('heroCanvas');\r\n      if(!canvas) return;\r\n      const ctx = canvas.getContext('2d', { alpha: true });\r\n      let width, height;\r\n      let particles = [];\r\n      let mouse = { x: window.innerWidth/2, y: window.innerHeight/2, targetX: window.innerWidth/2, targetY: window.innerHeight/2 };\r\n\r\n      function init() {\r\n        width = canvas.width = window.innerWidth;\r\n        height = canvas.height = window.innerHeight;\r\n        particles = [];\r\n        const count = window.innerWidth < 768 ? 50 : 120;\r\n        for(let i=0; i<count; i++) {\r\n          particles.push({\r\n            x: Math.random() * width,\r\n            y: Math.random() * height,\r\n            r: Math.random() * 1.5 + 0.3,\r\n            dx: (Math.random() - 0.5) * 0.3,\r\n            dy: (Math.random() - 0.5) * 0.3,\r\n            baseAlpha: Math.random() * 0.5 + 0.1,\r\n            z: Math.random() * 0.6 + 0.2 // Depth for parallax\r\n          });\r\n        }\r\n      }\r\n\r\n      window.addEventListener('resize', init);\r\n      \r\n      const heroSec = document.getElementById('hero');\r\n      heroSec.addEventListener('mousemove', (e) => {\r\n        const rect = heroSec.getBoundingClientRect();\r\n        mouse.targetX = e.clientX - rect.left;\r\n        mouse.targetY = e.clientY - rect.top;\r\n      });\r\n      heroSec.addEventListener('mouseleave', () => {\r\n        mouse.targetX = width/2;\r\n        mouse.targetY = height/2;\r\n      });\r\n\r\n      function animate() {\r\n        requestAnimationFrame(animate);\r\n        ctx.clearRect(0, 0, width, height);\r\n\r\n        // Extremely soft easing for luxury feel\r\n        mouse.x += (mouse.targetX - mouse.x) * 0.03;\r\n        mouse.y += (mouse.targetY - mouse.y) * 0.03;\r\n\r\n        const centerX = width / 2;\r\n        const centerY = height / 2;\r\n        \r\n        const shiftX = (mouse.x - centerX) * 0.06;\r\n        const shiftY = (mouse.y - centerY) * 0.06;\r\n\r\n        particles.forEach(p => {\r\n          p.x += p.dx;\r\n          p.y += p.dy;\r\n\r\n          if(p.x < -20) p.x = width + 20;\r\n          if(p.x > width + 20) p.x = -20;\r\n          if(p.y < -20) p.y = height + 20;\r\n          if(p.y > height + 20) p.y = -20;\r\n\r\n          // Inverse parallax: closer particles move more\r\n          const px = p.x - shiftX * p.z;\r\n          const py = p.y - shiftY * p.z;\r\n\r\n          ctx.beginPath();\r\n          ctx.arc(px, py, p.r, 0, Math.PI * 2);\r\n          ctx.fillStyle = `rgba(201, 168, 76, ${p.baseAlpha})`;\r\n          ctx.fill();\r\n        });\r\n      }\r\n      \r\n      init();\r\n      animate();\r\n    })();\r\n  </script>\r\n</section>\r\n\r\n<!-- ═══ 2. PROCESS ═══ -->\r\n<section id=\"proceso\" class=\"sec\" style=\"background:var(--dark)\">\r\n  <div class=\"wrap\" style=\"max-width:800px\">\r\n    <div class=\"fade text-center\" style=\"margin-bottom:12px\">\r\n      <span class=\"pill pill-gold\" data-en=\"Application Process\" data-es=\"Proceso de Aplicación\">Application Process</span>\r\n    </div>\r\n    <h2 class=\"heading-section text-center fade d1\" data-en=\"Your path, in five steps\" data-es=\"Su camino, en cinco pasos\">Your path, in five steps</h2>\r\n    <p class=\"text-body text-center fade d2\" style=\"margin-bottom:60px;max-width:540px;margin-left:auto;margin-right:auto\" data-en=\"An exclusive process designed to find the special person.\" data-es=\"Un proceso exclusivo diseñado para encontrar a la persona especial.\">An exclusive process designed to find the special person.</p>\r\n\r\n    <div style=\"position:relative\">\r\n      <div class=\"process-step fade\">\r\n        <div class=\"process-num\">01</div>\r\n        <h3 class=\"process-title\" data-en=\"Initial Application\" data-es=\"Solicitud Inicial\">Initial Application</h3>\r\n        <p class=\"text-body\" style=\"margin:0\" data-en=\"Complete your application and share the necessary information to begin your process.\" data-es=\"Completa tu aplicación y comparte la información necesaria para iniciar tu proceso.\">Complete your application and share the necessary information to begin your process.</p>\r\n      </div>\r\n\r\n      <div class=\"process-step fade d1\">\r\n        <div class=\"process-num\">02</div>\r\n        <h3 class=\"process-title\" data-en=\"Preliminary Review\" data-es=\"Revisión preliminar\">Preliminary Review</h3>\r\n        <p class=\"text-body\" style=\"margin:0\" data-en=\"At no cost. We read your application and, only if your profile can move forward, we explain the next step.\" data-es=\"Sin costo. Leemos su solicitud y, solo si su perfil puede avanzar, le explicamos el paso siguiente.\">At no cost. We read your application and, only if your profile can move forward, we explain the next step.</p> </div>\r\n\r\n      <div class=\"process-step fade d2\">\r\n        <div class=\"process-num\">03</div>\r\n        <h3 class=\"process-title\" data-en=\"Evaluation &amp; Verification · USD 400\" data-es=\"Evaluación y verificación · USD 400\">Evaluation &amp; Verification · USD 400</h3>\r\n        <p class=\"text-body\" style=\"margin:0\" data-en=\"Covers the study, the evaluation and the background verification. It does not reserve a place and is not part of the programme; it is non-refundable once the evaluation begins.\" data-es=\"Cubre el estudio, la evaluación y la verificación de antecedentes. No reserva un cupo ni forma parte del programa; no es reembolsable una vez iniciada la evaluación.\">Covers the study, the evaluation and the background verification. It does not reserve a place and is not part of the programme; it is non-refundable once the evaluation begins.</p>\r\n      </div>\r\n\r\n      <div class=\"process-step fade d3\">\r\n        <div class=\"process-num\">04</div>\r\n        <h3 class=\"process-title\" data-en=\"Official Confirmation\" data-es=\"Confirmación Oficial\">Official Confirmation</h3>\r\n        <p class=\"text-body\" style=\"margin:0\" data-en=\"If selected, you will receive official approval to continue.\" data-es=\"Si eres seleccionado, recibirás la aprobación oficial para continuar.\">If selected, you will receive official approval to continue.</p>\r\n      </div>\r\n\r\n      <div class=\"process-step fade d4\">\r\n        <div class=\"process-num\">05</div>\r\n        <h3 class=\"process-title\" data-en=\"Program Access\" data-es=\"Acceso al Programa\">Program Access</h3>\r\n        <p class=\"text-body\" style=\"margin:0\" data-en=\"After approval, you make the single payment for the programme (USD 13,000).\" data-es=\"Tras la aprobación, realiza el pago único del programa (USD 13.000).\">After approval, you make the single payment for the programme (USD 13,000).</p>\r\n        <div class=\"process-price\"><span style=\"font-size:1.1rem;color:var(--gray);font-weight:400\"></span></div>\r\n        <div style=\"margin-top:24px;\">\r\n          <a href=\"https://zafiramatchagency.com/proceso/\" class=\"btn-gold\" style=\"display:inline-block; padding:10px 24px; font-size:0.95rem;\">\r\n            <span data-en=\"Discover our process (Gentlemen)\" data-es=\"Conoce nuestro proceso (Caballeros)\">Discover our process (Gentlemen)</span>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"fade text-center\" style=\"margin-top:50px\">\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"btn-gold\" style=\"padding:16px 48px;font-size:1rem\"><span data-en=\"Apply Now →\" data-es=\"Aplicar ahora →\">Apply Now →</span></a>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- ═══ 5. EVENT ═══ -->\r\n<section class=\"sec\" style=\"position:relative;overflow:hidden\">\r\n  <div class=\"ev-glow\"></div>\r\n  <div style=\"position:relative;z-index:2;text-align:center;max-width:680px;margin:0 auto\">\r\n    <div class=\"fade\"><span class=\"pill pill-gold\" style=\"margin-bottom:28px;display:inline-flex\" data-en=\"CARTAGENA, COLOMBIA · BY INVITATION ONLY\" data-es=\"CARTAGENA, COLOMBIA · SOLO POR INVITACIÓN\">CARTAGENA, COLOMBIA · BY INVITATION ONLY</span></div>\r\n    <h2 class=\"heading-section fade d1\" data-en=\"The Cartagena gathering\" data-es=\"El encuentro de Cartagena\">The Cartagena gathering</h2>\r\n    <p class=\"text-body text-center fade d2\" style=\"margin-bottom:20px;line-height:1.85\" data-en=\"After verification and approval, and only if you decide to continue with the programme, Zafira invites you to a private gathering in Cartagena. There, in-person introductions take place only when both people have agreed to them: no candidate is introduced without accepting that specific introduction, after receiving information about you. Each introduction is prepared with judgment, and the Zafira team accompanies every meeting.\" data-es=\"Después de la verificación y la aprobación, y solo si usted decide continuar con el programa, Zafira lo invita a un encuentro privado en Cartagena. Allí, las presentaciones en persona ocurren solo cuando las dos partes las han aceptado: ninguna candidata es presentada sin haberlo aceptado para ese caso concreto, después de recibir información sobre usted. Cada presentación se prepara con criterio, y el equipo de Zafira acompaña cada encuentro.\">After verification and approval, and only if you decide to continue with the programme, Zafira invites you to a private gathering in Cartagena. There, in-person introductions take place only when both people have agreed to them: no candidate is introduced without accepting that specific introduction, after receiving information about you. Each introduction is prepared with judgment, and the Zafira team accompanies every meeting.</p>\r\n    <p class=\"text-body text-center fade d2\" style=\"margin-bottom:32px;color:var(--gold)\" data-en=\"Verification on both sides. Consent in every case. Accompaniment at every meeting.\" data-es=\"Verificación de ambos lados. Consentimiento en cada caso. Acompañamiento en cada encuentro.\">Verification on both sides. Consent in every case. Accompaniment at every meeting.</p>\r\n    <div class=\"fade d3\">\r\n      <span class=\"pill pill-gold\" style=\"padding:10px 26px;font-size:.8rem;font-weight:500;letter-spacing:.06em\">\r\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\r\n        <span data-en=\"PRIVATE GATHERING · ACCOMPANIED BY ZAFIRA\" data-es=\"ENCUENTRO PRIVADO · ACOMPAÑADO POR ZAFIRA\">PRIVATE GATHERING · ACCOMPANIED BY ZAFIRA</span>\r\n      </span>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- ═══ 6. FOOTER ═══ -->\r\n<footer class=\"footer\"> \r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-href-en=\"https://zafiramatchagency.com/privacidad/\" data-href-es=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Privacy Policy\" data-es=\"Política de Privacidad\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/terminos/\" data-href-en=\"https://zafiramatchagency.com/terminos/\" data-href-es=\"https://zafiramatchagency.com/terminos-es/\" data-en=\"Terms &amp; Conditions\" data-es=\"Términos y Condiciones\">Terms &amp; Conditions</a>\r\n    <a href=\"https://zafiramatchagency.com/cancelaciones/\" data-href-en=\"https://zafiramatchagency.com/cancelaciones/\" data-href-es=\"https://zafiramatchagency.com/cancelaciones-es/\" data-en=\"Cancellations &amp; Refunds\" data-es=\"Cancelaciones y Reembolsos\">Cancellations &amp; Refunds</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <script>(function(){function u(l){document.querySelectorAll('a[data-href-'+l+']').forEach(function(a){a.href=a.getAttribute('data-href-'+l);});}var o=window.zafiraSetLang;window.zafiraSetLang=function(l){if(o)o(l);u(l);};function i(){u(window.zafiraGetLang?window.zafiraGetLang():'en');}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',i);}else{i();}})();</script>\r\n\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\"\r\n     data-en=\"Zafira is not a dating platform. We are a private matchmaking agency with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\"\r\n     \r\n     data-es=\"Zafira no es una plataforma de citas. Somos una agencia privada de matchmaking con procesos verificados. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">\r\n     \r\n     Zafira is not a dating platform. We are a private matchmaking agency with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\r\n  </p>\r\n</footer>\r\n\r\n<script>\r\n/* Scroll fade-in */\r\nconst obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\n/* Counter */\r\n(function(){const el=document.getElementById('counter');let go=false;const run=()=>{if(go)return;go=true;const t=98,d=2000,s=performance.now();const tick=n=>{const p=Math.min((n-s)/d,1),e=1-Math.pow(1-p,3);el.textContent=Math.round(e*t)+'%';if(p<1)requestAnimationFrame(tick)};requestAnimationFrame(tick)};const co=new IntersectionObserver(e=>{if(e[0].isIntersecting){run();co.disconnect()}},{threshold:.5});co.observe(el)})();\r\n/* Parallax */\r\nwindow.addEventListener('scroll',()=>{const bg=document.getElementById('heroBg');if(bg)bg.style.transform='translateY('+window.scrollY*.3+'px)';},{passive:true});\r\n</script>\r\n</body>\r\n</html>\r\n"
