   {
    "id": "5d82ba8",
    "elType": "widget",
    "settings": {
     "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>The Process | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Discover the selective Zafira verification and event-matching process. Every connection begins with trust.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<style>\r\n  /* ── INLINE STYLES FOR PROCESS LUXURY EXPERIENCE ── */\r\n  :root { --p-bg: #0a0a0f; --p-gold: #C9A84C; --p-text: #e2e2e2; }\r\n  body { background-color: var(--p-bg); overflow-x: hidden; }\r\n  \r\n  /* Hero */\r\n  .p-hero { position: relative; min-height: 90vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; padding: 0 24px; }\r\n  .p-hero-bg { position: absolute; inset: 0; z-index: 0; background-image: url('https://images.unsplash.com/photo-1574360773950-48e024225301?q=80&w=2000'); background-size: cover; background-position: center; filter: brightness(0.35) contrast(1.1); transform: scale(1.05); transition: transform 2s ease-out; }\r\n  .p-hero.vis .p-hero-bg { transform: scale(1); }\r\n  .p-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,10,15,0.8) 0%, rgba(10,10,15,0.3) 50%, var(--p-bg) 100%); z-index: 1; }\r\n  .p-hero-content { position: relative; z-index: 2; max-width: 800px; transform: translateY(30px); opacity: 0; transition: all 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.3s; }\r\n  .p-hero.vis .p-hero-content { transform: translateY(0); opacity: 1; }\r\n  .p-hero-title { font-family: var(--ff-d); font-size: clamp(2.8rem, 6vw, 5rem); font-weight: 500; color: var(--p-gold); letter-spacing: 0.05em; line-height: 1.1; margin-bottom: 24px; text-shadow: 0 10px 40px rgba(0,0,0,0.8); }\r\n  .p-hero-subtitle { font-size: clamp(1rem, 2vw, 1.15rem); color: var(--p-text); font-weight: 300; letter-spacing: 0.05em; line-height: 1.6; margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto; }\r\n  \r\n  /* Steps */\r\n  .p-step-wrap { padding: 120px 24px; background: var(--p-bg); border-bottom: 1px solid rgba(201,168,76,0.05); }\r\n  .p-step-wrap:nth-child(even) { background: #0c0c11; }\r\n  .p-step { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; max-width: 1200px; margin: 0 auto; }\r\n  .p-step-content { max-width: 500px; }\r\n  .p-step-num { font-family: var(--ff-d); font-size: 1.2rem; color: var(--p-gold); letter-spacing: 0.15em; margin-bottom: 16px; display: flex; align-items: center; gap: 12px; }\r\n  .p-step-num::before { content: ''; display: block; width: 40px; height: 1px; background: var(--p-gold); }\r\n  .p-step-title { font-family: var(--ff-d); font-size: clamp(2rem, 4vw, 3rem); color: var(--white); margin-bottom: 24px; line-height: 1.1; }\r\n  .p-step-desc { font-size: 1.05rem; color: rgba(255,255,255,0.75); line-height: 1.8; margin-bottom: 20px; }\r\n  \r\n  .p-step-img-wrap { position: relative; overflow: hidden; border-radius: 2px; box-shadow: 0 30px 60px rgba(0,0,0,0.6); aspect-ratio: 4/5; }\r\n  .p-step-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7) grayscale(20%); transition: transform 1.5s ease, filter 1.5s ease; }\r\n  .p-step-img-wrap:hover .p-step-img { transform: scale(1.05); filter: brightness(0.9) grayscale(0%); }\r\n  \r\n  /* Alternate layout */\r\n  .p-step-wrap:nth-child(even) .p-step-content { order: 1; }\r\n  .p-step-wrap:nth-child(even) .p-step-img-wrap { order: 2; }\r\n  \r\n  @media(max-width: 900px) { \r\n    .p-step { grid-template-columns: 1fr; gap: 40px; } \r\n    .p-step-wrap:nth-child(even) .p-step-content { order: 2; } \r\n    .p-step-wrap:nth-child(even) .p-step-img-wrap { order: 1; } \r\n  }\r\n  \r\n  /* Fade overrides */\r\n  .c-fade { opacity: 0; transform: translateY(40px); transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }\r\n  .c-fade.vis { opacity: 1; transform: translateY(0); }\r\n  .c-fade.d1 { transition-delay: 0.1s; }\r\n  .c-fade.d2 { transition-delay: 0.2s; }\r\n  .c-fade.d3 { transition-delay: 0.3s; }\r\n</style>\r\n<script>\r\n(function(){\r\n  function getLang(){ return localStorage.getItem('zafiraLang')||'en'; }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){ el.textContent=el.getAttribute('data-'+lang); });\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){ el.innerHTML=el.getAttribute('data-'+lang+'-html'); });\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){ btn.classList.toggle('active', btn.getAttribute('data-lang')===lang); });\r\n  }\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n  document.addEventListener('DOMContentLoaded',function(){ applyLang(getLang()); });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\"><img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA</a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n      <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n      <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n    <a href=\"https://zafiramatchagency.com/caballeros/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n  </div>\r\n</header>\r\n\r\n<main>\r\n\r\n  <!-- 0. HERO -->\r\n  <section class=\"p-hero\" id=\"process-hero\">\r\n    <div class=\"p-hero-bg\"></div>\r\n    <div class=\"p-hero-overlay\"></div>\r\n    <div class=\"p-hero-content\">\r\n      <div class=\"c-fade d1\">\r\n        <span class=\"pill pill-gold\" style=\"margin-bottom:24px;display:inline-flex;background:rgba(10,10,15,0.5);backdrop-filter:blur(10px)\">\r\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\r\n          <span data-en=\"Security & Selection\" data-es=\"Seguridad y Selección\">Security & Selection</span>\r\n        </span>\r\n      </div>\r\n      <h1 class=\"p-hero-title c-fade d2\" data-en=\"Every Connection Begins With Trust.\" data-es=\"Toda Conexión Comienza Con Confianza.\">Every Connection Begins With Trust.</h1>\r\n      <p class=\"p-hero-subtitle c-fade d3\" data-en=\"Zafira maintains a highly selective evaluation process. Because authentic, high-value experiences require safety, intentionality, and rigorous verification.\" data-es=\"Zafira mantiene un proceso de evaluación altamente selectivo. Porque las experiencias auténticas de alto valor requieren seguridad, intencionalidad y verificación rigurosa.\">Zafira maintains a highly selective evaluation process. Because authentic, high-value experiences require safety, intentionality, and rigorous verification.</p>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 1. INITIAL APPLICATION -->\r\n  <section class=\"p-step-wrap\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"p-step-num\">STEP 01</div>\r\n        <h2 class=\"p-step-title\" data-en=\"Initial Application\" data-es=\"Solicitud Inicial\">Initial Application</h2>\r\n        <p class=\"p-step-desc\" data-en=\"The journey begins with a discreet digital application. We review your personal information to ensure our environments align with your aspirations.\" data-es=\"El viaje comienza con una discreta solicitud digital. Revisamos su información personal para asegurar que nuestros entornos se alineen con sus aspiraciones.\">The journey begins with a discreet digital application. We review your personal information to ensure our environments align with your aspirations.</p>\r\n        <p class=\"p-step-desc\" data-en=\"This first qualification stage is completely confidential. We evaluate intentionality and basic lifestyle compatibility before inviting you to proceed.\" data-es=\"Esta primera etapa de calificación es completamente confidencial. Evaluamos la intencionalidad y la compatibilidad de estilo de vida básica antes de invitarle a proceder.\">This first qualification stage is completely confidential. We evaluate intentionality and basic lifestyle compatibility before inviting you to proceed.</p>\r\n      </div>\r\n      <div class=\"p-step-img-wrap c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/step01.png\" alt=\"Initial Application\" class=\"p-step-img\">\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 2. REVISION PRELIMINAR -->\r\n  <section class=\"p-step-wrap\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-img-wrap c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/step02.png\" alt=\"Verification\" class=\"p-step-img\">\r\n      </div>\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"p-step-num\">STEP 02</div>\r\n        <h2 class=\"p-step-title\" data-en=\"Preliminary Review\" data-es=\"Revisión preliminar\">Preliminary Review</h2>\r\n        <p class=\"p-step-desc\" data-en=\"At no cost. We read your application and, only if your profile can move forward, we explain the next step: the evaluation and verification.\" data-es=\"Sin costo. Leemos su solicitud y, solo si su perfil puede avanzar, le explicamos el paso siguiente: la evaluación y verificación.\">At no cost. We read your application and, only if your profile can move forward, we explain the next step: the evaluation and verification.</p>\r\n        <div style=\"background:rgba(201,168,76,0.1); border-left:2px solid var(--p-gold); padding:16px; margin-bottom:20px;\">\r\n          <p class=\"p-step-desc\" style=\"margin-bottom:0; font-size:0.95rem;\" data-en-html=\"<strong>EVALUATION &amp; VERIFICATION · USD 400:</strong> covers the study, the evaluation and the background verification. It does not reserve a place and is not part of the programme (USD 13,000); it is non-refundable once the evaluation begins.\" data-es-html=\"<strong>EVALUACIÓN Y VERIFICACIÓN · USD 400:</strong> cubre el estudio, la evaluación y la verificación de antecedentes. No reserva un cupo ni forma parte del programa (USD 13.000); no es reembolsable una vez iniciada la evaluación.\"><strong>EVALUATION &amp; VERIFICATION · USD 400:</strong> covers the study, the evaluation and the background verification. It does not reserve a place and is not part of the programme (USD 13,000); it is non-refundable once the evaluation begins.</p>\r\n        </div>\r\n        <p class=\"p-step-desc\" data-en=\"All participants are carefully reviewed. We verify identity, civil status, and global records to ensure an environment of absolute trust.\" data-es=\"Todos los participantes son revisados cuidadosamente. Verificamos identidad, estado civil y registros globales para asegurar un entorno de absoluta confianza.\">All participants are carefully reviewed. We verify identity, civil status, and global records to ensure an environment of absolute trust.</p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 3. PRIVATE CONSULTATION -->\r\n  <section class=\"p-step-wrap\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"p-step-num\">STEP 03</div>\r\n        <h2 class=\"p-step-title\" data-en=\"Private Consultation\" data-es=\"Consulta Privada\">Private Consultation</h2>\r\n        <p class=\"p-step-desc\" data-en=\"Following verification, you will schedule a discreet, one-on-one consultation with a dedicated Zafira advisor.\" data-es=\"Tras la verificación, programará una consulta discreta y personalizada con un asesor exclusivo de Zafira.\">Following verification, you will schedule a discreet, one-on-one consultation with a dedicated Zafira advisor.</p>\r\n        <p class=\"p-step-desc\" data-en=\"This elegant interaction allows us to evaluate your goals, expectations, and lifestyle alignment. We provide personalized guidance to ensure that our selective network is the right fit for your future.\" data-es=\"Esta elegante interacción nos permite evaluar sus objetivos, expectativas y alineación de estilo de vida. Brindamos orientación personalizada para asegurar que nuestra red selecta sea la adecuada para su futuro.\">This elegant interaction allows us to evaluate your goals, expectations, and lifestyle alignment. We provide personalized guidance to ensure that our selective network is the right fit for your future.</p>\r\n      </div>\r\n      <div class=\"p-step-img-wrap c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/step03.png\" alt=\"Consultation\" class=\"p-step-img\">\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 4. PROFILE APPROVAL -->\r\n  <section class=\"p-step-wrap\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-img-wrap c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/step04.png\" alt=\"Approval\" class=\"p-step-img\">\r\n      </div>\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"p-step-num\">STEP 04</div>\r\n        <h2 class=\"p-step-title\" data-en=\"Profile Approval\" data-es=\"Aprobación de Perfil\">Profile Approval</h2>\r\n        <p class=\"p-step-desc\" data-en=\"Zafira remains a highly exclusive environment. Not every application is accepted.\" data-es=\"Zafira sigue siendo un entorno altamente exclusivo. No todas las solicitudes son aceptadas.\">Zafira remains a highly exclusive environment. Not every application is accepted.</p>\r\n        <p class=\"p-step-desc\" data-en=\"Once your consultation and background checks are complete, selected applicants receive formal approval. Quality, authenticity, and refined character matter deeply to us. This ensures that every individual you meet shares a comparable standard of excellence.\" data-es=\"Una vez completada su consulta y verificación de antecedentes, los solicitantes seleccionados reciben aprobación formal. La calidad, la autenticidad y el carácter refinado nos importan profundamente. Esto asegura que cada persona que conozca comparta un estándar de excelencia comparable.\">Once your consultation and background checks are complete, selected applicants receive formal approval. Quality, authenticity, and refined character matter deeply to us. This ensures that every individual you meet shares a comparable standard of excellence.</p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 5. EVENT & PROGRAM ACCESS -->\r\n  <section class=\"p-step-wrap\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"p-step-num\">STEP 05</div>\r\n        <h2 class=\"p-step-title\" data-en=\"Event & Program Access\" data-es=\"Acceso a Eventos y Programas\">Event & Program Access</h2>\r\n        <p class=\"p-step-desc\" data-en=\"Upon approval, and only if you decide to continue, you make a single payment for the programme.\" data-es=\"Tras la aprobación, y solo si usted decide continuar, se realiza un único pago del programa.\">Upon approval, and only if you decide to continue, you make a single payment for the programme.</p>\r\n        <p class=\"p-step-desc\" style=\"font-size:1.5rem; font-family:var(--ff-d); color:var(--p-gold); margin:24px 0;\" data-en=\"$13,000 USD\" data-es=\"$13,000 USD\">$13,000 USD</p>\r\n        <p class=\"p-step-desc\" data-en=\"This single payment covers the personalised search, verification, private introductions and the Cartagena programme.\" data-es=\"Este único pago cubre la búsqueda personalizada, la verificación, las presentaciones privadas y el programa en Cartagena.\">This single payment covers the personalised search, verification, private introductions and the Cartagena programme.</p>\r\n      </div>\r\n      <div class=\"p-step-img-wrap c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/step05.png\" alt=\"Event Access\" class=\"p-step-img\">\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- 6. THE EXPERIENCE -->\r\n  <section class=\"p-step-wrap\" style=\"border-bottom:none;\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-img-wrap c-fade d1\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/step06.png\" alt=\"The Experience\" class=\"p-step-img\">\r\n      </div>\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"p-step-num\">STEP 06</div>\r\n        <h2 class=\"p-step-title\" data-en=\"The Cartagena Programme\" data-es=\"El programa en Cartagena\">The Cartagena Programme</h2>\r\n        <p class=\"p-step-desc\" data-en=\"A private, accompanied programme in Cartagena: a welcome, organised meetings with the candidates selected for you, cultural activities and a closing dinner.\" data-es=\"Un programa privado y acompañado en Cartagena: bienvenida, encuentros organizados con las candidatas seleccionadas para usted, actividades culturales y una cena de cierre.\">A private, accompanied programme in Cartagena: a welcome, organised meetings with the candidates selected for you, cultural activities and a closing dinner.</p>\r\n        <p class=\"p-step-desc\" data-en=\"Zafira&#039;s team is with you throughout the official dates. The final agenda, venue and dates are confirmed in writing beforehand.\" data-es=\"El equipo de Zafira lo acompaña durante las fechas oficiales. La agenda, la sede y las fechas se confirman por escrito antes.\">Zafira’s team is with you throughout the official dates. The final agenda, venue and dates are confirmed in writing beforehand.</p>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CTA -->\r\n  <!-- ═══ SECTION 1 — HERO + URGENCY ═══ -->\r\n  <section id=\"hero\" class=\"p-step-wrap\" style=\"padding-top: 60px; border-bottom: none;\">\r\n    <div class=\"p-step\">\r\n      <div class=\"p-step-content c-fade\">\r\n        <div class=\"fade\" style=\"margin-bottom:24px; display:inline-flex; align-items:center; gap:12px;\">\r\n          <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"Zafira Diamond\" style=\"width:28px; height:auto; mix-blend-mode:lighten;\">\r\n          <span class=\"pill pill-gold\" style=\"margin:0; background:rgba(201,168,76,0.1); border:1px solid rgba(201,168,76,0.3); font-size:0.8rem; letter-spacing:0.15em;\" data-en=\"ZAFIRA • PRIVATE EXPERIENCE\" data-es=\"ZAFIRA • EXPERIENCIA PRIVADA\">ZAFIRA • PRIVATE EXPERIENCE</span>\r\n        </div>\r\n        \r\n        <h1 class=\"p-step-title c-fade d1\" style=\"font-size: clamp(2.5rem, 4vw, 3.5rem); margin-bottom: 12px; line-height:1.1;\" data-en-html=\"Welcome to the<br><span class='text-gold'>Zafira Experience</span>\" data-es-html=\"Bienvenido a la<br><span class='text-gold'>Experiencia Zafira</span>\">Welcome to the<br><span class=\"text-gold\">Zafira Experience</span></h1>\r\n        \r\n        <p class=\"c-fade d2\" style=\"font-size: 1rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.7); margin-bottom: 24px; font-weight:300;\" data-en=\"Exclusive Private Event • Cartagena • October or November 2026 (dates to be confirmed)\" data-es=\"Evento Privado Exclusivo • Cartagena • Octubre o noviembre de 2026 (fechas por confirmar)\">Exclusive Private Event • Cartagena • October or November 2026 (dates to be confirmed)</p>\r\n        \r\n        <p class=\"p-step-desc c-fade d2\" style=\"font-size:1.1rem; line-height:1.7;\" data-en=\"Not another dating event. A private, invitation-only experience where exceptional men meet distinguished, feminine, and accomplished women in an environment designed for authentic connection.\" data-es=\"No es otro evento de citas. Una experiencia privada y solo por invitación donde hombres excepcionales conocen a mujeres distinguidas, femeninas y realizadas en un entorno diseñado para una conexión auténtica.\">Not another dating event. A private, invitation-only experience where exceptional men meet distinguished, feminine, and accomplished women in an environment designed for authentic connection.</p>\r\n        \r\n        <div class=\"c-fade d3\" style=\"background:rgba(201,168,76,0.05); border-left:2px solid var(--p-gold); padding:16px; margin: 32px 0;\">\r\n          <p class=\"p-step-desc\" style=\"margin-bottom:0; font-size:1.1rem; color: var(--white);\" data-en-html=\"<strong>Exact dates and the application deadline will be confirmed before places open.</strong>\" data-es-html=\"<strong>Las fechas exactas y el cierre de solicitudes se confirman antes de abrir los cupos.</strong>\"><strong>Exact dates and the application deadline will be confirmed before places open.</strong></p>\r\n        </div>\r\n        \r\n        <div class=\"c-fade d4\" style=\"display:flex; flex-direction:column; gap:20px; align-items:flex-start;\">\r\n          <a href=\"https://zafiramatchagency.com/caballeros/\" class=\"btn-gold\" style=\"padding:16px 32px; font-size:1rem; letter-spacing:0.05em;\" data-en=\"Apply for Your Private Invitation\" data-es=\"Solicita Tu Invitación Privada\">Apply for Your Private Invitation</a>\r\n          <a href=\"#journey\" style=\"color:var(--p-gold); text-decoration:none; font-size:0.95rem; letter-spacing:0.05em; display:inline-flex; align-items:center; gap:8px; border-bottom: 1px solid transparent; transition: border-color 0.3s;\" onmouseover=\"this.style.borderBottomColor='var(--p-gold)'\" onmouseout=\"this.style.borderBottomColor='transparent'\" data-en=\"Discover the Experience ↓\" data-es=\"Descubre la Experiencia ↓\">Discover the Experience ↓</a>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"p-step-img-wrap c-fade d2\" style=\"box-shadow: 0 30px 60px rgba(0,0,0,0.6);\">\r\n        <img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/05/zafira_luxury_chemistry.jpg\" alt=\"Luxury rooftop conversation in Cartagena\" class=\"p-step-img\" loading=\"lazy\">\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <section class=\"sec text-center\" style=\"padding-bottom:120px; background:var(--blac