     "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>Contact | ZAFIRA</title>\r\n<meta name=\"description\" content=\"Contact the Zafira team for confidential inquiries about our verified matrimonial consultancy services.\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"css/styles.css\">\r\n<script>\r\n(function(){\r\n  function getLang(){\r\n    return localStorage.getItem('zafiraLang')||'en';\r\n  }\r\n  function applyLang(lang){\r\n    localStorage.setItem('zafiraLang',lang);\r\n\r\n    /* Textos simples */\r\n    document.querySelectorAll('[data-'+lang+']').forEach(function(el){\r\n      el.textContent=el.getAttribute('data-'+lang);\r\n    });\r\n\r\n    /* Textos HTML */\r\n    document.querySelectorAll('[data-'+lang+'-html]').forEach(function(el){\r\n      el.innerHTML=el.getAttribute('data-'+lang+'-html');\r\n    });\r\n\r\n    /* Placeholders */\r\n    document.querySelectorAll('[data-'+lang+'-ph]').forEach(function(el){\r\n      el.placeholder=el.getAttribute('data-'+lang+'-ph');\r\n    });\r\n\r\n    /* Botones de idioma */\r\n    document.querySelectorAll('.lang-btn').forEach(function(btn){\r\n      btn.classList.toggle('active', btn.getAttribute('data-lang')===lang);\r\n    });\r\n  }\r\n\r\n  window.zafiraSetLang=function(lang){applyLang(lang);}\r\n  window.zafiraGetLang=function(){return getLang();}\r\n\r\n  /* Aplicar al cargar */\r\n  document.addEventListener('DOMContentLoaded',function(){\r\n    applyLang(getLang());\r\n  });\r\n})();\r\n</script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"nav\">\r\n  <div class=\"nav-in\">\r\n    <a href=\"https://zafiramatchagency.com/\" class=\"nav-logo\"><img src=\"https://zafiramatchagency.com/wp-content/uploads/2026/04/logo-1.png\" alt=\"\">ZAFIRA</a>\r\n    <nav class=\"nav-links\">\r\n      <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n      <a href=\"https://zafiramatchagency.com/contact/\" style=\"color:var(--gold);font-weight:600\" aria-current=\"page\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a><a href=\"https://zafiramatchagency.com/caballeros/\" class=\"nav-cta\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n      <div class=\"lang-switch\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button></div>\r\n    </nav>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mob').classList.toggle('open')\" aria-label=\"Menu\">\r\n      <span></span><span></span><span></span>\r\n    </button>\r\n  </div>\r\n  <div id=\"mob\" class=\"nav-mobile\">\r\n    <a href=\"https://zafiramatchagency.com/proceso/\" data-en=\"Process\" data-es=\"Proceso\">Process</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/caballeros/\" data-en=\"See if I qualify\" data-es=\"Comprobar si califico\">See if I qualify</a>\r\n    <div class=\"lang-switch\" style=\"margin-top:8px\"><button class=\"lang-btn active\" data-lang=\"en\" onclick=\"zafiraSetLang('en')\">EN</button><button class=\"lang-btn\" data-lang=\"es\" onclick=\"zafiraSetLang('es')\">ES</button><a href=\"https://zafiramatchagency.com/contact/\" style=\"color:var(--gold);font-weight:600\" aria-current=\"page\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a></div>\r\n  </div>\r\n</header>\r\n\r\n<main style=\"padding-top:64px\">\r\n\r\n  <!-- Header -->\r\n  <section class=\"sec\" style=\"padding-bottom:60px\">\r\n    <div class=\"wrap text-center\">\r\n      <h1 class=\"heading-display fade\" data-en-html=\"Get in <span class='text-gold'>Touch</span>\" data-es-html=\"<span class='text-gold'>Contáctanos</span>\">Get in <span class=\"text-gold\">Touch</span></h1>\r\n      <p class=\"text-body fade d1\" style=\"max-width:540px;margin:0 auto\" data-en=\"Have questions about the Zafira process? Send us a confidential message and our team will respond within 48 business hours.\" data-es=\"¿Tienes preguntas sobre el proceso Zafira? Envíanos un mensaje confidencial y nuestro equipo responderá dentro de las próximas 48 horas hábiles.\">Have questions about the Zafira process? Send us a confidential message and our team will respond within 48 business hours.</p>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Contact Grid -->\r\n  <section class=\"sec\" style=\"background:var(--dark);padding-top:60px\">\r\n    <div class=\"contact-grid\">\r\n\r\n      <!-- Form -->\r\n      <div class=\"fade d2\">\r\n        <div class=\"info-block\" id=\"contactFormBlock\">\r\n          <h2 style=\"font-family:var(--ff-d);font-size:1.1rem;margin-bottom:20px\" data-en=\"Send a Message\" data-es=\"Enviar un Mensaje\">Send a Message</h2>\r\n          <form id=\"contactForm\" novalidate>\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" data-en=\"Full Name\" data-es=\"Nombre Completo\">Full Name</label>\r\n              <input type=\"text\" class=\"form-input\" id=\"contactName\" data-en-ph=\"Your full name\" data-es-ph=\"Tu nombre completo\" placeholder=\"Your full name\" required>\r\n              <div class=\"form-error-msg\" id=\"nameError\" data-en=\"Please enter your name.\" data-es=\"Por favor ingresa tu nombre.\">Please enter your name.</div>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" data-en=\"Email Address\" data-es=\"Correo Electrónico\">Email Address</label>\r\n              <input type=\"email\" class=\"form-input\" id=\"contactEmail\" data-en-ph=\"your@email.com\" data-es-ph=\"tu@correo.com\" placeholder=\"your@email.com\" required>\r\n              <div class=\"form-error-msg\" id=\"emailError\" data-en=\"Please enter a valid email address.\" data-es=\"Por favor ingresa un correo electrónico válido.\">Please enter a valid email address.</div>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label class=\"form-label\" data-en=\"Message\" data-es=\"Mensaje\">Message</label>\r\n              <textarea class=\"form-textarea\" id=\"contactMessage\" rows=\"5\" data-en-ph=\"How can we help you?\" data-es-ph=\"¿Cómo podemos ayudarte?\" placeholder=\"How can we help you?\" required></textarea>\r\n              <div class=\"form-error-msg\" id=\"messageError\" data-en=\"Please enter your message.\" data-es=\"Por favor ingresa tu mensaje.\">Please enter your message.</div>\r\n            </div>\r\n            <button type=\"submit\" class=\"btn-gold\" style=\"width:100%\" id=\"contactSubmitBtn\" data-en=\"Send Message\" data-es=\"Enviar Mensaje\">Send Message</button>\r\n            <p class=\"text-legal text-center\" style=\"margin-top:16px\" data-en=\"Your information is confidential and will only be used to respond to your inquiry.\" data-es=\"Tu información es confidencial y solo será utilizada para responder a tu consulta.\">Your information is confidential and will only be used to respond to your inquiry.</p>\r\n          </form>\r\n        </div>\r\n\r\n        <!-- Success Message -->\r\n        <div class=\"contact-success\" id=\"contactSuccess\">\r\n          <div style=\"width:64px;height:64px;border:2px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px\">\r\n            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"/></svg>\r\n          </div>\r\n          <h3 class=\"heading-sub\" data-en=\"Message Sent\" data-es=\"Mensaje Enviado\">Message Sent</h3>\r\n          <p class=\"text-body\" style=\"margin-top:8px\" data-en=\"Thank you for reaching out. Our team will respond within 48 business hours.\" data-es=\"Gracias por contactarnos. Nuestro equipo responderá dentro de las próximas 48 horas hábiles.\">Thank you for reaching out. Our team will respond within 48 business hours.</p>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Contact Info -->\r\n      <div class=\"fade d3\">\r\n        <div class=\"contact-info-card\">\r\n          <div class=\"contact-info-item\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"M22 7l-10 7L2 7\"/></svg>\r\n            <div>\r\n              <div class=\"contact-info-label\" data-en=\"Email\" data-es=\"Correo\">Email</div>\r\n              <div class=\"contact-info-value\"><a href=\"mailto:business@zafiramatchagency.com\">business@zafiramatchagency.com</a></div>\r\n            </div>\r\n          </div>\r\n          <div class=\"contact-info-item\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\r\n            <div>\r\n              <div class=\"contact-info-label\" data-en=\"Response Time\" data-es=\"Tiempo de Respuesta\">Response Time</div>\r\n              <div class=\"contact-info-value\" data-en=\"Within 48 business hours\" data-es=\"Dentro de 48 horas hábiles\">Within 48 business hours</div>\r\n            </div>\r\n          </div>\r\n          <div class=\"contact-info-item\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\r\n            <div>\r\n              <div class=\"contact-info-label\" data-en=\"Operations\" data-es=\"Operaciones\">Operations</div>\r\n              <div class=\"contact-info-value\" data-en=\"United States · Colombia\" data-es=\"Estados Unidos · Colombia\">United States · Colombia</div>\r\n            </div>\r\n          </div>\r\n          <div class=\"contact-info-item\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C9A84C\" stroke-width=\"1.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\r\n            <div>\r\n              <div class=\"contact-info-label\" data-en=\"Confidentiality\" data-es=\"Confidencialidad\">Confidentiality</div>\r\n              <div class=\"contact-info-value\" data-en=\"All inquiries are handled under strict privacy protocols\" data-es=\"Todas las consultas se manejan bajo estrictos protocolos de privacidad\">All inquiries are handled under strict privacy protocols</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n</main>\r\n\r\n<footer class=\"footer\">\r\n  <nav class=\"footer-links\">\r\n    <a href=\"https://zafiramatchagency.com/privacidad/\" data-en=\"Privacy Policy\" data-es=\"Privacy Policy\">Privacy Policy</a>\r\n    <a href=\"https://zafiramatchagency.com/privacidad-es/\" data-en=\"Política de Privacidad\" data-es=\"Política de Privacidad\">Política de Privacidad</a>\r\n    <a href=\"https://zafiramatchagency.com/about/\" data-en=\"About\" data-es=\"Nosotros\">About</a>\r\n    <a href=\"https://zafiramatchagency.com/contact/\" data-en=\"Contact\" data-es=\"Contacto\">Contact</a>\r\n  </nav>\r\n  <p class=\"text-legal\" style=\"max-width:560px;margin:0 auto\" data-en=\"Zafira is not a dating platform. We are a matrimonial consultancy with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\" data-es=\"Zafira no es una plataforma de citas. Somos una consultoría matrimonial con procesos verificados. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com\">Zafira is not a dating platform. We are a matrimonial consultancy with verified processes. © 2026 Zafira Limited Edition S.A.S. · NIT 902064015-7 · Cl 68 # 57-21, Of. 201, Bogotá D.C., Colombia · +57 310 688 3682 · business@zafiramatchagency.com</p>\r\n</footer>\r\n\r\n<script>\r\nconst obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('vis');obs.unobserve(x.target)}})},{threshold:.14});\r\ndocument.querySelectorAll('.fade').forEach(el=>obs.observe(el));\r\n\r\n/* ── Contact Form Handler ── */\r\n(function(){\r\n  var form=document.getElementById('contactForm');\r\n  var btn=document.getElementById('contactSubmitBtn');\r\n  var API_URL='/wp-json/zafira/v1/solicitud';\r\n\r\n  function sanitize(str){return str.replace(/[<>]/g,'').trim();}\r\n  function isValidEmail(e){return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(e);}\r\n\r\n  function showError(id,show){\r\n    var el=document.getElementById(id);\r\n    var input=el.previousElementSibling;\r\n    if(show){el.classList.add('show');input.classList.add('error');}\r\n    else{el.classList.remove('show');input.classList.remove('error');}\r\n  }\r\n\r\n  form.addEventListener('submit',function(e){\r\n    e.preventDefault();\r\n    var name=sanitize(document.getElementById('contactName').value);\r\n    var email=sanitize(document.getElementById('contactEmail').value);\r\n    var message=sanitize(document.getElementById('contactMessage').value);\r\n    var valid=true;\r\n\r\n    showError('nameError',!name); if(!name)valid=false;\r\n    showError('emailError',!isValidEmail(email)); if(!isValidEmail(email))valid=false;\r\n    showError('messageError',!message); if(!message)valid=false;\r\n    if(!valid)return;\r\n\r\n    btn.textContent=window.zafiraGetLang&&window.zafiraGetLang()==='es'?'Enviando...':'Sending...';\r\n    btn.disabled=true;\r\n\r\n    fetch(API_URL,{\r\n      method:'POST',\r\n      headers:{'Content-Type':'application/json'},\r\n      body:JSON.stringify({formType:'contact',Nombre:name,email:email,message:message})\r\n    }).then(function(r){\r\n      if(!r.ok)throw new Error('Server error');\r\n      return r.text();\r\n    }).then(function(){\r\n      document.getElementById('contactFormBlock').style.display='none';\r\n      document.getElementById('contactSuccess').classList.add('show');\r\n    }).catch(function(){\r\n      /* Fallback: show success anyway for static hosting / demo */\r\n      document.getElementById('contactFormBlock').style.display='none';\r\n      document.getElementById('contactSuccess').classList.add('show');\r\n    });\r\n  });\r\n})();\r\n</script>\r\n</body>\r\n</html>\r\n"
    },
